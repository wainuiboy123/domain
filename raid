-- fetch_chest.lua
-- CC: Tweaked turtle program
--
-- Carefully tunnels to a chest at a given coordinate, loots or breaks it,
-- then returns home.
--
-- USAGE:
--   fetch_chest <x> <y> <z>
--
-- It will first try GPS (gps.locate()). If that fails (no GPS host array
-- in range, or no modem attached), it will ask you for the turtle's
-- current x/y/z/facing instead.
--
-- FACING CONVENTION (matches Minecraft's compass):
--   0 = north (-Z)   1 = east (+X)   2 = south (+Z)   3 = west (-X)
--
-- CONFIG:
local MODE = "loot"            -- "loot" = suck items out and leave the chest
                                -- "break" = suck items out THEN break the chest
local FUEL_SAFETY_MARGIN = 20  -- reserve fuel kept beyond the calculated round trip
local FUEL_CHECK_EVERY = 8     -- only re-check fuel every N blocks (speed)
local INV_CHECK_EVERY = 8      -- only check inventory fullness every N blocks (speed)

-------------------------------------------------
local args = { ... }
if #args < 3 then
    print("Usage: fetch_chest <x> <y> <z>")
    return
end

local targetX = tonumber(args[1])
local targetY = tonumber(args[2])
local targetZ = tonumber(args[3])

if not (targetX and targetY and targetZ) then
    print("Invalid coordinates.")
    return
end

-------------------------------------------------
-- Facing: 0=north(-Z) 1=east(+X) 2=south(+Z) 3=west(-X)
-------------------------------------------------
local facing
local startPos = {}
local pos

local function askNumber(prompt)
    while true do
        io.write(prompt .. ": ")
        local input = read()
        local n = tonumber(input)
        if n then return n end
        print("Please enter a number.")
    end
end

local function askFacing()
    while true do
        io.write("Which way is the turtle facing right now? (north/south/east/west): ")
        local input = read()
        if input then
            input = input:lower()
            if input == "north" then return 0
            elseif input == "east" then return 1
            elseif input == "south" then return 2
            elseif input == "west" then return 3
            end
        end
        print("Please type north, south, east, or west.")
    end
end

-- Try GPS first. Calibrate facing by moving one block and comparing
-- positions (GPS gives position, not heading).
local function tryGPSSetup()
    if not turtle then return false end
    local ok = pcall(function() return peripheral.find("modem") end)
    if not ok or not peripheral.find("modem") then return false end

    local x1, y1, z1 = gps.locate(2)
    if not x1 then return false end

    local moved = false
    for _ = 1, 3 do
        if turtle.forward() then
            moved = true
            break
        else
            turtle.dig()
            turtle.attack()
        end
    end
    if not moved then return false end

    local x2, y2, z2 = gps.locate(2)
    if not x2 then return false end

    local dx, dz = x2 - x1, z2 - z1
    if dz == -1 then facing = 0       -- moved north
    elseif dx == 1 then facing = 1    -- moved east
    elseif dz == 1 then facing = 2    -- moved south
    elseif dx == -1 then facing = 3   -- moved west
    else return false end

    startPos = { x = x1, y = y1, z = z1 }
    pos = { x = x2, y = y2, z = z2 }
    return true
end

print("Looking for GPS...")
if tryGPSSetup() then
    print("GPS found. Calibrated successfully.")
else
    print("No GPS available - please enter position manually.")
    startPos = {
        x = askNumber("Current X"),
        y = askNumber("Current Y"),
        z = askNumber("Current Z"),
    }
    facing = askFacing()
    pos = { x = startPos.x, y = startPos.y, z = startPos.z }
end

-------------------------------------------------
-- Fuel safety
-------------------------------------------------
local function manhattan(a, b)
    return math.abs(a.x - b.x) + math.abs(a.y - b.y) + math.abs(a.z - b.z)
end

local function tryRefuel()
    if turtle.getFuelLevel() == "unlimited" then return end
    for slot = 1, 16 do
        turtle.select(slot)
        if turtle.refuel(0) then
            turtle.refuel()
        end
    end
    turtle.select(1)
end

tryRefuel()
if turtle.getFuelLevel() ~= "unlimited" then
    local there = manhattan(startPos, { x = targetX, y = targetY, z = targetZ })
    local need = (there * 2) + FUEL_SAFETY_MARGIN
    if turtle.getFuelLevel() < need then
        print(string.format("Not enough fuel. Have %d, need ~%d for the round trip.",
            turtle.getFuelLevel(), need))
        print("Add fuel to the turtle's inventory and run again.")
        return
    end
end

-------------------------------------------------
-- Hazard-aware digging
-------------------------------------------------
local LIQUID_NAMES = { ["minecraft:water"] = true, ["minecraft:lava"] = true }

local function findPlaceableSlot()
    for slot = 1, 16 do
        local detail = turtle.getItemDetail(slot)
        if detail and not detail.name:find("bucket") then
            return slot
        end
    end
    return nil
end

local function clearDirection(inspectFn, digFn, placeFn, detectFn)
    local exists, data = inspectFn()
    if not exists then return "clear" end

    if LIQUID_NAMES[data.name] then
        local slot = findPlaceableSlot()
        if not slot then return "hazard_unsealed" end
        turtle.select(slot)
        placeFn()
        turtle.select(1)
        if not detectFn() then return "hazard_unsealed" end
    end

    for attempt = 1, 4 do
        if not detectFn() then return "clear" end
        digFn()
    end

    if detectFn() then return "unbreakable" end
    return "clear"
end

local function haltForSafety(reason)
    print("STOPPING for safety: " .. reason)
    print(string.format("Turtle is currently at approx x=%d y=%d z=%d.", pos.x, pos.y, pos.z))
    error("halted", 0)
end

local function clearForward()
    local result = clearDirection(turtle.inspect, turtle.dig, turtle.place, turtle.detect)
    if result == "hazard_unsealed" then
        haltForSafety("Lava/water ahead and I have nothing to seal it with.")
    elseif result == "unbreakable" then
        haltForSafety("Block ahead won't break (bedrock or wrong tool?).")
    end
end

local function clearUp()
    local result = clearDirection(turtle.inspectUp, turtle.digUp, turtle.placeUp, turtle.detectUp)
    if result == "hazard_unsealed" then
        haltForSafety("Lava/water above and nothing to seal it with.")
    elseif result == "unbreakable" then
        haltForSafety("Block above won't break (bedrock or wrong tool?).")
    end
end

local function clearDown()
    local result = clearDirection(turtle.inspectDown, turtle.digDown, turtle.placeDown, turtle.detectDown)
    if result == "hazard_unsealed" then
        haltForSafety("Lava/water below and nothing to seal it with.")
    elseif result == "unbreakable" then
        haltForSafety("Block below won't break (bedrock or wrong tool?).")
    end
end

-------------------------------------------------
-- Movement
-------------------------------------------------
local blockCounter = 0

local function safeForward()
    for _ = 1, 6 do
        clearForward()
        if turtle.forward() then
            if facing == 0 then pos.z = pos.z - 1       -- north
            elseif facing == 1 then pos.x = pos.x + 1   -- east
            elseif facing == 2 then pos.z = pos.z + 1   -- south
            else pos.x = pos.x - 1 end                   -- west
            return true
        end
        turtle.attack()
    end
    haltForSafety("Kept getting blocked moving forward (mob spam or stuck).")
end

local function safeUp()
    for _ = 1, 6 do
        clearUp()
        if turtle.up() then
            pos.y = pos.y + 1
            return true
        end
        turtle.attackUp()
    end
    haltForSafety("Kept getting blocked moving up.")
end

local function safeDown()
    for _ = 1, 6 do
        clearDown()
        if turtle.down() then
            pos.y = pos.y - 1
            return true
        end
        turtle.attackDown()
    end
    haltForSafety("Kept getting blocked moving down.")
end

-- Clockwise: north(0) -> east(1) -> south(2) -> west(3) -> north(0)
local function turnRight() turtle.turnRight(); facing = (facing + 1) % 4 end
local function turnLeft()  turtle.turnLeft();  facing = (facing - 1) % 4 end

local function faceDirection(target)
    local diff = (target - facing) % 4
    if diff == 1 then turnRight()
    elseif diff == 2 then turnRight(); turnRight()
    elseif diff == 3 then turnLeft() end
end

local function dumpIfFull()
    for slot = 1, 16 do
        if turtle.getItemCount(slot) == 0 then return end
    end
    print("Inventory full - dropping oldest stack to keep moving.")
    turtle.select(1)
    turtle.drop()
    turtle.select(1)
end

local function periodicChecks()
    blockCounter = blockCounter + 1
    if blockCounter % INV_CHECK_EVERY == 0 then dumpIfFull() end
    if blockCounter % FUEL_CHECK_EVERY == 0 and turtle.getFuelLevel() ~= "unlimited" then
        tryRefuel()
        local backHome = manhattan(pos, startPos)
        if turtle.getFuelLevel() < backHome + 5 then
            haltForSafety("Fuel getting too low to guarantee getting home. Stopping here.")
        end
    end
end

local function moveAxisY(target)
    while pos.y < target do periodicChecks(); safeUp() end
    while pos.y > target do periodicChecks(); safeDown() end
end

local function moveAxisX(target)
    if pos.x == target then return end
    faceDirection(pos.x < target and 1 or 3)  -- east or west
    while pos.x ~= target do periodicChecks(); safeForward() end
end

local function moveAxisZ(target)
    if pos.z == target then return end
    faceDirection(pos.z < target and 2 or 0)  -- south or north
    while pos.z ~= target do periodicChecks(); safeForward() end
end

local function moveTo(x, y, z)
    moveAxisY(y)
    moveAxisX(x)
    moveAxisZ(z)
end

-------------------------------------------------
-- Main
-------------------------------------------------
print(string.format("Start: x=%d y=%d z=%d", pos.x, pos.y, pos.z))
print(string.format("Chest: x=%d y=%d z=%d", targetX, targetY, targetZ))

-- Approach from the north side (one block short on Z) so we don't walk
-- into the chest's own space, then face south into it.
local approachX, approachY, approachZ = targetX, targetY, targetZ - 1

local ok, err = pcall(function()
    moveTo(approachX, approachY, approachZ)
    faceDirection(2) -- face south, toward the chest

    print("Looting chest...")
    local pulledSomething = true
    while pulledSomething do
        dumpIfFull()
        pulledSomething = turtle.suck()
    end

    if MODE == "break" then
        print("Breaking chest...")
        clearForward()
    end

    print("Heading home...")
    moveTo(startPos.x, startPos.y, startPos.z)
end)

if not ok then
    print("Run ended early: " .. tostring(err))
    print("Attempting to return home from current position...")
    pcall(function()
        moveTo(startPos.x, startPos.y, startPos.z)
    end)
    return
end

print("Done. Back home with the loot.")
