--------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------
local function now() return math.floor(os.epoch("utc") / 1000) end
local function clamp(v, a, b) return math.max(a, math.min(b, v)) end
local function trunc(s, n)
  s = tostring(s)
  if #s > n then return s:sub(1, math.max(0, n - 1)) .. "~" end
  return s
end
local function sanitize(s) return (tostring(s):gsub("[^\32-\126]", "?")) end
local function fmtDT(t) return os.date("%m/%d %H:%M", t) end
local function fmtTime(t) return os.date("%H:%M:%S", t) end
local function ago(t)
  local d = math.max(0, now() - t)
  if d < 60 then return d .. "s"
  elseif d < 3600 then return math.floor(d / 60) .. "m"
  elseif d < 86400 then return math.floor(d / 3600) .. "h"
  else return math.floor(d / 86400) .. "d" end
end
local function fmtDur(s)
  s = math.floor(s)
  if s < 60 then return s .. "s" end
  if s < 3600 then return math.floor(s / 60) .. "m " .. (s % 60) .. "s" end
  return math.floor(s / 3600) .. "h " .. math.floor((s % 3600) / 60) .. "m"
end

local function wrap(s, width)
  local out, line = {}, ""
  width = math.max(4, width)
  for w0 in s:gmatch("%S+") do
    local word = w0
    while #word > width do
      if line ~= "" then out[#out + 1] = line; line = "" end
      out[#out + 1] = word:sub(1, width)
      word = word:sub(width + 1)
    end
    if line == "" then line = word
    elseif #line + 1 + #word <= width then line = line .. " " .. word
    else out[#out + 1] = line; line = word end
  end
  if line ~= "" or #out == 0 then out[#out + 1] = line end
  return out
end

