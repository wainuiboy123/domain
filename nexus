local function playerDims(s)
  local seen, out = {}, {}
  for i = 1, #s do
    local d = s[i][4]
    if not seen[d] then seen[d] = true; out[#out + 1] = d end
  end
  return out
end

local STEPS = { 16, 32, 50, 100, 200, 250, 500, 1000, 2000, 5000, 10000, 50000 }

local function buildHeat(s, tp, dimSel, PW, PH)
  local n = #s
  local lo, hi, idx = 1, n, 0
  while lo <= hi do
    local mid = floor((lo + hi) / 2)
    if s[mid][1] <= tp then idx = mid; lo = mid + 1 else hi = mid - 1 end
  end
  if idx == 0 then return nil end
  local dim = dimSel or s[idx][4]
  local minX, maxX, minZ, maxZ, count = math.huge, -math.huge, math.huge, -math.huge, 0
  for i = 1, idx do
    local e = s[i]
    if e[4] == dim then
      count = count + 1
      if e[2] < minX then minX = e[2] end
      if e[2] > maxX then maxX = e[2] end
      if e[3] < minZ then minZ = e[3] end
      if e[3] > maxZ then maxZ = e[3] end
    end
  end
  if count == 0 then return { empty = true, dim = dim, idx = idx } end
  local spanX = max(maxX - minX + 1, 48)
  local spanZ = max(maxZ - minZ + 1, 48)
  local scale = min(PW / spanX, PH / spanZ)

  local pix = {}
  -- faint grid
  local step = STEPS[#STEPS]
  for _, st in ipairs(STEPS) do if st * scale >= 30 then step = st; break end end
  local x = math.ceil(minX / step) * step
  while x <= minX + spanX do
    local c = floor((x - minX) * scale)
    if c >= 0 and c < PW then for r = 0, PH - 1 do pix[r * PW + c] = (x == 0) and K3 or K2 end end
    x = x + step
  end
  local z = math.ceil(minZ / step) * step
  while z <= minZ + spanZ do
    local r = PH - 1 - floor((z - minZ) * scale)
    if r >= 0 and r < PH then for c = 0, PW - 1 do pix[r * PW + c] = (z == 0) and K3 or K2 end end
    z = z + step
  end

  local g = {}
  local function add(px, pz, wgt)
    local c = clamp(floor((px - minX) * scale), 0, PW - 1)
    local r = clamp(PH - 1 - floor((pz - minZ) * scale), 0, PH - 1)
    local k = r * PW + c
    g[k] = (g[k] or 0) + wgt
  end
  local prev
  for i = 1, idx do
    local e = s[i]
    if e[4] == dim then
      if prev and e[1] - prev[1] <= 120 then
        local dt = min(e[1] - prev[1], 30)
        local steps = max(1, math.ceil(max(math.abs(e[2] - prev[2]), math.abs(e[3] - prev[3])) * scale))
        steps = min(steps, 400)
        local wgt = dt / (steps + 1)
        for k = 0, steps do
          local f = k / steps
          add(prev[2] + (e[2] - prev[2]) * f, prev[3] + (e[3] - prev[3]) * f, wgt)
        end
      else
        add(e[2], e[3], 1)
      end
      prev = e
    else
      prev = nil
    end
  end
  local g2, gmax = {}, 0
  for k, v in pairs(g) do
    g2[k] = (g2[k] or 0) + v
    local c = k % PW
    if c > 0 then g2[k - 1] = (g2[k - 1] or 0) + v * 0.25 end
    if c < PW - 1 then g2[k + 1] = (g2[k + 1] or 0) + v * 0.25 end
    if k >= PW then g2[k - PW] = (g2[k - PW] or 0) + v * 0.25 end
    if k < PW * (PH - 1) then g2[k + PW] = (g2[k + PW] or 0) + v * 0.25 end
  end
  for _, v in pairs(g2) do if v > gmax then gmax = v end end
  local lg = math.log(1 + gmax)
  for k, v in pairs(g2) do
    local ratio = lg > 0 and (math.log(1 + v) / lg) or 1
    pix[k] = HEATC[clamp(math.ceil(ratio * #HEATC), 1, #HEATC)]
  end
  local cur = s[idx]
  if cur[4] == dim then
    local mc = clamp(floor((cur[2] - minX) * scale), 0, PW - 1)
    local mr = clamp(PH - 1 - floor((cur[3] - minZ) * scale), 0, PH - 1)
    local function mk(c, r, col)
      if c >= 0 and c < PW and r >= 0 and r < PH then pix[r * PW + c] = col end
    end
    for d = 2, 3 do
      mk(mc - d, mr, WH); mk(mc + d, mr, WH); mk(mc, mr - d, WH); mk(mc, mr + d, WH)
    end
    mk(mc, mr, YL); mk(mc - 1, mr, YL); mk(mc + 1, mr, YL); mk(mc, mr - 1, YL); mk(mc, mr + 1, YL)
  end
  return { pix = pix, idx = idx, dim = dim, minX = minX, minZ = minZ,
           maxX = minX + spanX - 1, maxZ = minZ + spanZ - 1,
           spanX = spanX, spanZ = spanZ, scale = scale, cur = cur, step = step }
end

local HL = {}
local PIECE = {}
local function heatLayout()
  local hs = CONFIG.HEAT_PX
  HL.hs = hs
  HL.cx, HL.cy = M, CY0
  HL.PW = floor((PXW - 2 * M) / hs)
  HL.PH = floor((CY1 - CY0 - 62) / hs)
  HL.cw, HL.ch = HL.PW * hs, HL.PH * hs
  HL.ctrlY = HL.cy + HL.ch + 10
end

local function pushCanvas(res)
  local hs, PW, PH = HL.hs, HL.PW, HL.PH
  local pix = res and res.pix or {}
  local rows = {}
  for r = 0, PH - 1 do
    local t, base = {}, r * PW
    for c = 0, PW - 1 do
      local col = pix[base + c] or K0
      local pc = PIECE[col]
      if not pc then pc = string.rep(string.char(col), hs); PIECE[col] = pc end
      t[c + 1] = pc
    end
    local s = table.concat(t)
    for _ = 1, hs do rows[#rows + 1] = s end
  end
  put(HL.cx, HL.cy, rows)
end

local function heatControls(register)
  local s = hm.player and data.heat[hm.player]
  local y = HL.ctrlY
  local x, w = M, PXW - 2 * M
  rect(x, y, w, 62, K0)
  -- timeline
  rect(x, y, w, 6, K2)
  if s then
    local t0, tN = s[1][1], s[#s][1]
    local frac = (hm.tp - t0) / max(1, tN - t0)
    local fw = floor(frac * w)
    rect(x, y, fw, 6, O4)
    rect(clamp(x + fw - 2, x, x + w - 4), y - 3, 4, 12, WH)
    text(x, y + 12, fmtDT(t0), G1, K0)
    rtext(x + w, y + 12, fmtDT(tN), G1, K0)
    ctext(x, w, y + 12, fmtDT(hm.tp) .. ":" .. string.format("%02d", floor(hm.tp) % 60), G2, K0)
  end
  if register then addHit("hseek", x, y - 6, w, 20) end
  -- icon row
  local iy = y + 28
  local function ib(id, name, ix, iw, active)
    rect(ix, iy, iw, 26, K0)
    local w0, h0 = iconSize(name, 1)
    icon(ix + floor((iw - w0) / 2), iy + floor((26 - h0) / 2), name, active and O4 or O5, K0, 1)
    if register then addHit(id, ix, iy, iw, 26) end
  end
  ib("hstart", "start", x, 34)
  ib("hrew", "rew", x + 36, 40, hm.playing and hm.rate < 0)
  ib("hplay", hm.playing and "pause" or "play", x + 78, 40, true)
  ib("hff", "ff", x + 120, 40, hm.playing and hm.rate > 0)
  ib("hend", "finish", x + 162, 34)
  local lab = hm.playing and (math.abs(hm.rate) .. "x " .. (hm.rate < 0 and "REWIND" or "PLAY")) or "PAUSED"
  text(x + 208, iy + 9, lab, hm.playing and O4 or G1, K0)
  if s then
    local info = string.upper(hm.player) .. "   " .. #s .. " SAMPLES   " .. fmtDur(max(0, s[#s][1] - s[1][1])) .. " TRACKED"
    rtext(x + w, iy + 9, fit(info, w - 300, 1), G1, K0)
  end
end

local function heatDynamic(register)
  local s = hm.player and data.heat[hm.player]
  local res
  if s and #s > 0 then
    local t0, tN = s[1][1], s[#s][1]
    if hm.follow or not hm.tp then hm.tp = tN end
    hm.tp = clamp(hm.tp, t0, tN)
    res = buildHeat(s, hm.tp, hm.dim, HL.PW, HL.PH)
  else
    s = nil
  end
  pushCanvas(res and res.pix and res or nil)
  if res and res.pix then
    local lo = string.format("X%d Z%d", res.minX, res.minZ)
    local hi = string.format("X%d Z%d", res.maxX, res.maxZ)
    text(HL.cx + 3, HL.cy + HL.ch - 11, lo, G1, K0)
    rtext(HL.cx + HL.cw - 3, HL.cy + 3, hi, G1, K0)
    local cur = string.format("%s   X %d   Z %d   GRID %d", dimShort(res.cur[4]), res.cur[2], res.cur[3], res.step)
    rtext(HL.cx + HL.cw - 3, HL.cy + HL.ch - 11, cur, O5, K0)
  else
    local msg
    if not s then msg = "NO MOVEMENT DATA RECORDED YET"
    elseif res and res.empty then msg = "NO DATA IN THIS DIMENSION"
    else msg = "PLAYHEAD IS BEFORE THE FIRST SAMPLE" end
    ctext(HL.cx, HL.cw, HL.cy + floor(HL.ch / 2), msg, G1, K0)
  end
  heatControls(register)
end

local function drawHeat()
  local list = heatPlayers()
  if not hm.player or not data.heat[hm.player] or #data.heat[hm.player] == 0 then
    hm.player = list[1]; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
  end
  heatLayout()
  rect(HL.cx - 1, HL.cy - 1, HL.cw + 2, HL.ch + 2, K3)
  heatDynamic(true)
end

