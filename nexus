--------------------------------------------------------------------
-- drawing primitives
--------------------------------------------------------------------
local function fill(x, y, w, h, bg)
  if w <= 0 or h <= 0 then return end
  local s = string.rep(" ", w)
  win.setBackgroundColor(bg)
  for j = y, y + h - 1 do win.setCursorPos(x, j); win.write(s) end
end
local function text(x, y, s, fg, bg)
  win.setCursorPos(x, y)
  win.setBackgroundColor(bg or C.bg)
  win.setTextColor(fg or C.text)
  win.write(s)
end
local function ctext(x, w, y, s, fg, bg)
  text(x + math.floor((w - #s) / 2), y, s, fg, bg)
end
local function button(id, x, y, w, h, label, bg, fg, d)
  fill(x, y, w, h, bg)
  label = trunc(label, w - 1)
  text(x + math.floor((w - #label) / 2), y + math.floor((h - 1) / 2), label, fg or C.text, bg)
  hits[#hits + 1] = { x = x, y = y, w = w, h = h, id = id, data = d }
end
local function panel(x, y, w, h, title, accent)
  fill(x, y, w, h, C.panel)
  fill(x, y, 1, h, accent)
  if title then text(x + 2, y, title, accent, C.panel) end
end
local function dot(x, y, col) fill(x, y, 1, 1, col) end
local function gradientBar(y)
  local cols = { C.blue, C.cyan, C.green, C.lime, C.yellow, C.orange, C.pink, C.purple }
  local seg = math.ceil(W / #cols)
  for i, c in ipairs(cols) do fill((i - 1) * seg + 1, y, seg, 1, c) end
end
local function coordLine(x, y, p, bg)
  text(x, y, "X", C.orange, bg);       text(x + 2, y, tostring(p.x), C.text, bg)
  local o = 2 + #tostring(p.x) + 2
  text(x + o, y, "Y", C.lime, bg);     text(x + o + 2, y, tostring(p.y), C.text, bg)
  o = o + 2 + #tostring(p.y) + 2
  text(x + o, y, "Z", C.cyan, bg);     text(x + o + 2, y, tostring(p.z), C.text, bg)
end

