local ROWSTR = pcall(mon.drawPixels, 0, 0, { string.char(K0) })
local function put(x, y, rows)
  if not ROWSTR then
    for i = 1, #rows do
      local s, t = rows[i], {}
      for j = 1, #s do t[j] = s:byte(j) end
      rows[i] = t
    end
  end
  mon.drawPixels(x, y, rows)
end
local function freeze(b) pcall(mon.setFrozen, b) end

local function rect(x, y, w, h, c)
  x, y, w, h = floor(x), floor(y), floor(w), floor(h)
  if x < 0 then w = w + x; x = 0 end
  if y < 0 then h = h + y; y = 0 end
  if x + w > PXW then w = PXW - x end
  if y + h > PXH then h = PXH - y end
  if w <= 0 or h <= 0 then return end
  local s = string.rep(string.char(c), w)
  local rows = {}
  for i = 1, h do rows[i] = s end
  put(x, y, rows)
end

