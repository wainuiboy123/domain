local function lock()
  ui.locked = true; ui.pin = ""; ui.msg = ""; ui.modal = nil; ui.drawer = nil
  hm.playing = false; inv.pick = nil
end
local function cycle(v, n) return (v % n) + 1 end

local function openUserPicker()
  ui.modal = {
    type = "picker", title = "SELECT USERS  (tap to toggle)", page = 1, clear = true,
    items = allUsers,
    isSel = function(n) return cs.users[n] ~= nil end,
    pick = function(n) cs.users[n] = (not cs.users[n]) or nil; bumpFilter() end,
    onClear = function() cs.users = {}; bumpFilter() end,
  }
end
local function openHeatPicker()
  ui.modal = {
    type = "picker", title = "SELECT PLAYER", page = 1, single = true,
    items = heatPlayers,
    isSel = function(n) return hm.player == n end,
    pick = function(n)
      hm.player = n; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
    end,
  }
end
local function openChestPicker()
  local mgr = inv.sel
  if not mgr then return end
  ui.modal = {
    type = "picker", title = "SELECT CHEST PERIPHERAL FOR " .. string.upper(mgr), page = 1, single = true,
    items = function()
      local a = { "(AUTO)" }
      for _, n in ipairs(inv.cands) do a[#a + 1] = n end
      return a
    end,
    isSel = function(n)
      local c = data.inv.chest[mgr]
      if n == "(AUTO)" then return c == nil end
      return c == n
    end,
    pick = function(n)
      data.inv.chest[mgr] = (n ~= "(AUTO)") and n or nil
      dirty = true; inv.crow = 0; inv.pick = nil
      invRefresh(false)
    end,
  }
end

-- tapping the scrollbar jumps straight to that position
local function seekPos(id, ty)
  local sb = SB[id]
  if not sb or sb.total <= sb.vis then return nil end
  local frac = clamp((ty - sb.y - sb.th / 2) / max(1, sb.h - sb.th), 0, 1)
  return floor(frac * (sb.total - sb.vis) + 0.5), sb.total - sb.vis
end

local function handleHit(h, tx, ty)
  local id, d = h.id, h.data

  -- modal controls
  if id == "mcancel" then ui.modal = nil; return end
  if id == "mconfirm" then
    local f = ui.modal and ui.modal.yes
    ui.modal = nil
    if f then f() end
    return
  end
  if id == "key" then if ui.modal and #ui.modal.buf < 40 then ui.modal.buf = ui.modal.buf .. d end return
  elseif id == "kbs" then ui.modal.buf = ui.modal.buf:sub(1, -2) return
  elseif id == "kclr" then ui.modal.buf = "" return
  elseif id == "kok" then cs.q = ui.modal.buf; ui.modal = nil; bumpFilter(); return
  elseif id == "pick" then
    ui.modal.pick(d)
    if ui.modal.single then ui.modal = nil end
    return
  elseif id == "pclear" then ui.modal.onClear(); return
  elseif id == "pdone" then ui.modal = nil; return
  elseif id == "pg-" then ui.modal.page = ui.modal.page - 1; return
  elseif id == "pg+" then ui.modal.page = ui.modal.page + 1; return
  end

  -- lock screen
  if id == "pin" then
    if now() < ui.lockUntil then return end
    ui.msg = ""
    if d == "CLR" then ui.pin = ""
    elseif d == "DEL" then ui.pin = ui.pin:sub(1, -2)
    elseif #ui.pin < #CONFIG.PIN then
      ui.pin = ui.pin .. d
      if #ui.pin == #CONFIG.PIN then
        if ui.pin == CONFIG.PIN then
          ui.locked = false; ui.pin = ""; ui.wrong = 0; ui.lastAct = now()
        else
          ui.pin = ""; ui.wrong = ui.wrong + 1; ui.msg = "INCORRECT PIN"
          if ui.wrong >= 5 then ui.lockUntil = now() + 30; ui.wrong = 0; ui.msg = "" end
        end
      end
    end
    return
  end

  -- header / drawers
  if id == "tab" then
    ui.tab = d; ui.drawer = nil
    if d == "inv" then invRefresh(true) end
  elseif id == "lock" then lock()
  elseif id == "filterbtn" then ui.drawer = (ui.drawer == "filter") and nil or "filter"
  elseif id == "menubtn" then ui.drawer = (ui.drawer == "heat") and nil or "heat"
  elseif id == "drawerclose" then ui.drawer = nil

  -- system
  elseif id == "syssave" then saveNow()
  elseif id == "sysdebug" then writeDebug(next(data.players))

  -- inventory
  elseif id == "invmgr" then
    inv.sel = d; inv.pick = nil; inv.crow = 0; invRefresh(false)
  elseif id == "invslot" then
    local st = inv.sel and inv.cache[inv.sel]
    local it = invItemAt(st, d.side, d.slot)
    if not it then inv.pick = nil
    elseif inv.pick and inv.pick.side == d.side and inv.pick.slot == d.slot then inv.pick = nil
    else inv.pick = { side = d.side, slot = d.slot } end
  elseif id == "invdesel" then inv.pick = nil
  elseif id == "invmove" then invMove(d)
  elseif id == "invdir" then
    if inv.sel then
      local cur = data.inv.dir[inv.sel] or "auto"
      local ci = 1
      for i, v in ipairs(DIRS) do if v == cur then ci = i end end
      local nx = DIRS[(ci % #DIRS) + 1]
      data.inv.dir[inv.sel] = (nx ~= "auto") and nx or nil
      dirty = true
    end
  elseif id == "invchest" then openChestPicker()
  elseif id == "invrefresh" then invRefresh(true)
  elseif id == "invmpg-" then inv.mpage = max(0, inv.mpage - 1)
  elseif id == "invmpg+" then inv.mpage = inv.mpage + 1
  elseif id == "invcr-" then inv.crow = max(0, inv.crow - 1)
  elseif id == "invcr+" then inv.crow = inv.crow + 1

  -- tracking
  elseif id == "trkrow" then trk.sel = (trk.sel == d) and nil or d
  elseif id == "detclose" then trk.sel = nil
  elseif id == "trkscroll" then
    local p = seekPos(id, ty)
    if p then trk.scroll = p end
  elseif id == "trkheat" then
    if trk.sel and data.heat[trk.sel] and #data.heat[trk.sel] > 0 then
      hm.player = trk.sel; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
    end
    ui.tab = "heat"
  elseif id == "trkdel" then
    local name = trk.sel
    if name then
      confirm("Delete ALL tracking data, last-seen location and heatmap history for " .. name .. "?",
        function() deletePlayer(name) end)
    end

  -- chat
  elseif id == "cmsg" then cs.sel[d] = (not cs.sel[d]) or nil
  elseif id == "chatscroll" then
    local p, maxp = seekPos(id, ty)
    if p then cs.scroll = maxp - p end
  elseif id == "cclear" then cs.sel = {}
  elseif id == "cdelsel" then
    local n, set = 0, {}
    for e in pairs(cs.sel) do set[e] = true; n = n + 1 end
    if n > 0 then confirm("Delete the " .. n .. " selected message(s) from history?", function() deleteChat(set) end) end
  elseif id == "cdelall" then
    local set, n = {}, #cs.filtered
    for _, e in ipairs(cs.filtered) do set[e] = true end
    if n > 0 then
      ui.drawer = nil
      confirm("Delete all " .. n .. " messages currently shown by the filters?", function() deleteChat(set) end)
    end
  elseif id == "fuser" then openUserPicker()
  elseif id == "fday" then cs.day = cycle(cs.day, #DAYS); bumpFilter()
  elseif id == "ftime" then cs.time = cycle(cs.time, #TIMES); bumpFilter()
  elseif id == "flen" then cs.len = cycle(cs.len, #LENS); bumpFilter()
  elseif id == "fevents" then cs.events = not cs.events; bumpFilter()
  elseif id == "fsearch" then ui.modal = { type = "kbd", buf = cs.q, title = "SEARCH CHAT MESSAGES" }
  elseif id == "freset" then
    cs.users = {}; cs.day = 1; cs.time = 1; cs.len = 1; cs.events = true; cs.q = ""; bumpFilter()

  -- heatmap
  elseif id == "hmplayer" then openHeatPicker()
  elseif id == "hmdim" then
    local s = hm.player and data.heat[hm.player]
    if s then
      local opts = { false }
      for _, v in ipairs(playerDims(s)) do opts[#opts + 1] = v end
      local cur = 1
      for i, v in ipairs(opts) do if v == (hm.dim or false) then cur = i end end
      hm.dim = opts[(cur % #opts) + 1] or nil
    end
  elseif id == "hmdel" then
    local name = hm.player
    if name then
      ui.drawer = nil
      confirm("Delete the entire heatmap history for " .. name .. "?", function() deleteHeat(name) end)
    end
  elseif id == "hplay" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      if hm.playing then hm.playing = false
      else
        local t0, tN = s[1][1], s[#s][1]
        if hm.rate > 0 and (hm.tp or tN) >= tN then hm.tp = t0 end
        if hm.rate < 0 and (hm.tp or t0) <= t0 then hm.tp = tN end
        hm.playing = true; hm.follow = false; hm.last = os.epoch("utc") / 1000
      end
    end
  elseif id == "hff" or id == "hrew" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      local dir = (id == "hff") and 1 or -1
      if hm.playing and (hm.rate > 0) == (dir > 0) then
        local r = math.abs(hm.rate) * 2
        if r > 16 then r = 1 end
        hm.rate = r * dir
      else
        hm.rate = dir
        if dir > 0 and (hm.tp or 0) >= s[#s][1] then hm.tp = s[1][1] end
        if dir < 0 and (hm.tp or 0) <= s[1][1] then hm.tp = s[#s][1] end
        hm.playing = true
      end
      hm.follow = false; hm.last = os.epoch("utc") / 1000
    end
  elseif id == "hstart" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then hm.tp = s[1][1]; hm.follow = false; hm.playing = false end
  elseif id == "hend" then hm.follow = true; hm.playing = false
  elseif id == "hseek" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      local frac = clamp((tx - h.x) / max(1, h.w - 1), 0, 1)
      local t0, tN = s[1][1], s[#s][1]
      hm.tp = t0 + frac * (tN - t0)
      hm.follow = false
    end
  end
end

-- monitor_touch may report character cells or raw pixels depending on the
-- CC: Graphics version. "auto" starts with chars and latches to pixels the
-- first time a touch lands outside the character grid.
local touchPixels = (CONFIG.TOUCH_MODE == "pixel")
local function touchToPx(cx, cy)
  if CONFIG.TOUCH_MODE == "auto" and not touchPixels and (cx > W or cy > H) then touchPixels = true end
  if touchPixels then return cx, cy end
  return (cx - 0.5) * PXW / W, (cy - 0.5) * PXH / H
end

local function onTouch(cx, cy)
  if not ui.locked then ui.lastAct = now() end
  local tx, ty = touchToPx(cx, cy)
  diag.touch = string.format("event %s,%s -> px %d,%d (%s)", tostring(cx), tostring(cy), floor(tx), floor(ty),
                             touchPixels and "pixel mode" or "char mode")
  for i = #hits, 1, -1 do
    local h = hits[i]
    if tx >= h.x and tx < h.x + h.w and ty >= h.y and ty < h.y + h.h then
      handleHit(h, tx, ty)
      return
    end
  end
end

local function frame()
  local t = os.epoch("utc") / 1000
  local dt = min(0.5, t - (hm.last or t))
  hm.last = t
  if not hm.playing then return end
  local s = hm.player and data.heat[hm.player]
  if not s or #s == 0 then hm.playing = false; return end
  local t0, tN = s[1][1], s[#s][1]
  local span = max(activeDuration(s), 60)       -- 1x plays all active time in ~30s
  hm.tp = (hm.tp or tN) + hm.rate * span / 30 * dt
  -- skip long idle gaps (player offline / not moving) instead of waiting through them
  local i = sampleIndex(s, hm.tp)
  if i >= 1 then
    if hm.rate > 0 and i < #s and s[i + 1][1] - hm.tp > 45 then hm.tp = s[i + 1][1] - 1
    elseif hm.rate < 0 and hm.tp - s[i][1] > 45 then hm.tp = s[i][1] + 1 end
  end
  if hm.rate > 0 and hm.tp >= tN then hm.tp = tN; hm.playing = false; hm.follow = true
  elseif hm.rate < 0 and hm.tp <= t0 then hm.tp = t0; hm.playing = false end
end

--------------------------------------------------------------------
-- MAIN
--------------------------------------------------------------------
local function safePoll()
  local ok, err = pcall(poll)
  if not ok then diag.err = "poll: " .. tostring(err); logErr("poll: " .. tostring(err)) end
end

local function main()
  loadData()
  safePoll()
  startup = false
  saveNow()
  local tickT = os.startTimer(1)
  local frameT
  local tick = 0

  local function handle(ev)
    local e = ev[1]
    local redraw, heatOnly = false, false

    if e == "monitor_touch" and ev[2] == monName then
      onTouch(ev[3], ev[4]); redraw = true

    elseif e == "chat" then
      diag.chatN = diag.chatN + 1; diag.chatLast = now()
      -- the argument order differs between Advanced Peripherals versions, so
      -- pick the strings out by shape: skip the UUID, then username, message
      local raw, strs = {}, {}
      for i = 2, 7 do
        local v = ev[i]
        if v ~= nil then
          raw[#raw + 1] = tostring(v)
          if type(v) == "string" and not v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then strs[#strs + 1] = v end
        end
      end
      diag.chatRaw = sanitize(table.concat(raw, " | ")):sub(1, 220)
      if strs[1] then
        logEvent("c", strs[1], strs[2] or "(no message)")
        ensurePlayer(strs[1])
        redraw = true
      end

    elseif e == "playerJoin" then
      if ev[2] then setOnline(ev[2]); redraw = true end

    elseif e == "playerLeave" then
      if ev[2] then setOffline(ev[2]); redraw = true end

    elseif e == "playerChangedDimension" then
      if ev[2] then
        local p = ensurePlayer(ev[2])
        if ev[4] then p.dim = dimId(ev[4]) end
        addSample(ev[2], p, true)
        redraw = true
      end

    elseif e == "char" then
      if ui.modal and ui.modal.type == "kbd" and #ui.modal.buf < 40 then
        ui.modal.buf = ui.modal.buf .. ev[2]; redraw = true
      end
      if not ui.locked then ui.lastAct = now() end

    elseif e == "key" then
      if ui.modal and ui.modal.type == "kbd" then
        if ev[2] == keys.backspace then ui.modal.buf = ui.modal.buf:sub(1, -2); redraw = true
        elseif ev[2] == keys.enter then cs.q = ui.modal.buf; ui.modal = nil; bumpFilter(); redraw = true end
      end

    elseif e == "timer" then
      if ev[2] == tickT then
        tickT = os.startTimer(1)
        tick = tick + 1
        local polled = false
        if tick % CONFIG.POLL_EVERY == 0 then safePoll(); polled = true end
        if not ui.locked and now() - ui.lastAct >= CONFIG.LOCK_AFTER then lock(); redraw = true end
        if dirty and now() - lastTry >= CONFIG.SAVE_EVERY then saveNow() end
        if polled and not ui.modal and not (ui.tab == "heat" and hm.playing) then redraw = true end
        if not polled and ui.tab == "sys" and not ui.locked and not ui.modal then redraw = true end
        if ui.tab == "inv" and not ui.locked and not ui.modal and tick % CONFIG.INV_POLL == 0 then
          invRefresh(false); redraw = true
        end
      elseif ev[2] == frameT then
        frameT = nil
        frame()
        heatOnly = true
      end
    end

    if hm.playing and not frameT and not ui.locked and ui.tab == "heat" then
      hm.last = hm.last or (os.epoch("utc") / 1000)
      frameT = os.startTimer(0.15)
    end
    if redraw then render()
    elseif heatOnly then renderHeatFrame() end
  end

  render()
  while true do
    local ev = { os.pullEventRaw() }
    if ev[1] == "terminate" then break end
    local ok, err = pcall(handle, ev)
    if not ok then
      logErr("event " .. tostring(ev[1]) .. ": " .. tostring(err))
      pcall(render)
    end
  end

  saveNow()
end

local ok, err = pcall(main)
pcall(function() mon.setGraphicsMode(0) end)
pcall(function() mon.setBackgroundColor(colors.black); mon.clear() end)
pcall(function()
  for c = 0, 15 do
    local col = 2 ^ c
    mon.setPaletteColor(col, term.nativePaletteColor(col))
  end
end)
if not ok then
  pcall(saveNow)
  error(err, 0)
end
print("NEXUS stopped. Data saved.")
