local nbtRead, saveNow
do
local function jstr(v) return '"' .. (tostring(v):gsub('[\\"]', '\\%0')) .. '"' end

-- hand-rolled JSON writer: textutils.serialiseJSON is far too slow for thousands
-- of heatmap samples (it could trip "too long without yielding")
local function encode(f)
  local parts = { '{"v":1,"saved":', tostring(floor(data.saved or 0)), ',"dims":', textutils.serialiseJSON(data.dims),
                  ',"inv":', textutils.serialiseJSON(data.inv),
                  ',"players":', textutils.serialiseJSON(data.players), ',"chat":[' }
  local nc, c = #data.chat, {}
  for i = nc - floor(nc * f) + 1, nc do
    local e = data.chat[i]
    c[#c + 1] = string.format("[%d,%s,%s,%s]", floor(e[1]), jstr(e[2]), jstr(e[3]), jstr(e[4]))
  end
  parts[#parts + 1] = table.concat(c, ",")
  parts[#parts + 1] = '],"heat":{'
  local hh = {}
  for name, sm in pairs(data.heat) do
    local ns, r = #sm, {}
    for i = ns - floor(ns * f) + 1, ns do
      local e = sm[i]
      r[#r + 1] = string.format("[%d,%d,%d,%d]", floor(e[1]), floor(e[2]), floor(e[3]), floor(e[4]))
    end
    hh[#hh + 1] = jstr(name) .. ":[" .. table.concat(r, ",") .. "]"
  end
  parts[#parts + 1] = table.concat(hh, ",")
  parts[#parts + 1] = "}}"
  return table.concat(parts)
end

-- NBT Storage access that adapts to whatever methods the peripheral really has
local function nbtWrite(t)
  local errs, tried = {}, {}
  local function try(name, arg)
    if tried[name] then return false end
    tried[name] = true
    local fn = nbt[name]
    if type(fn) ~= "function" then return false end
    local ok, res, msg = pcall(fn, arg)
    if ok and res ~= false and type(res) ~= "string" and msg == nil then diag.nbtWriter = name; return true end
    errs[#errs + 1] = name .. ": " .. tostring(ok and (msg or res) or res)
    return false
  end
  if diag.nbtWriter == "writeJson" and try("writeJson", textutils.serialiseJSON(t)) then return true end
  if try("writeTable", t) then return true end
  if try("writeJson", textutils.serialiseJSON(t)) then return true end
  for name, fn in pairs(nbt) do
    if type(fn) == "function" and name:match("^write") and try(name, t) then return true end
  end
  if #errs == 0 then errs[1] = "no write method" end
  return false, table.concat(errs, " | ")
end

function nbtRead()
  for _, name in ipairs({ "read", "readTable", "get" }) do
    local fn = nbt[name]
    if type(fn) == "function" then
      local ok, t = pcall(fn)
      if ok and type(t) == "table" then return t end
    end
  end
end

local function saveInner()
  data.saved = now()
  diag.saveErr = ""
  local full = encode(1)
  if CONFIG.LOCAL_MIRROR then
    local f = fs.open(CONFIG.LOCAL_FILE, "w")
    if f then f.write(full); f.close(); diag.localBytes = #full
    else diag.saveErr = "cannot write " .. CONFIG.LOCAL_FILE end
  end
  if nbt and nbtNoWrite then
    nbtOK = false
    diag.nbtErr = "peripheral '" .. nbtName .. "' has no write method"
  elseif nbt then
    for _ = 1, 5 do
      local f = 1.0
      if #full > nbtBudget then f = nbtBudget / #full * 0.95 end
      local pj = (f >= 1) and full or encode(f)
      while #pj > nbtBudget and f > 0.02 do f = f * 0.85; pj = encode(f) end
      local t, n = {}, 0
      for i = 1, #pj, 30000 do n = n + 1; t["c" .. n] = pj:sub(i, i + 29999) end
      t.n = n
      local ok, err = nbtWrite(t)
      if ok then
        nbtOK = true; diag.nbtErr = ""; lastSaveBytes = #pj
        break
      end
      -- the NBT Storage refused it (too big?) - shrink the budget and retry
      nbtOK = false
      diag.nbtErr = tostring(err)
      nbtBudget = max(1000, floor(nbtBudget * 0.7))
    end
  end
  dirty = false
  lastSave = now()
end
function saveNow()
  lastTry = now()
  local ok, err = pcall(saveInner)
  if not ok then diag.saveErr = tostring(err); logErr("save: " .. tostring(err)) end
end
end -- do (save)

local function decode(json)
  if not json or json == "" then return nil end
  local ok, t = pcall(textutils.unserialiseJSON, json)
  if ok and type(t) == "table" then return t end
end

local function loadData()
  local best
  if fs.exists(CONFIG.LOCAL_FILE) then
    local f = fs.open(CONFIG.LOCAL_FILE, "r")
    if f then best = decode(f.readAll()); f.close() end
  end
  if nbt then
    local t = nbtRead()
    if type(t) == "table" and t.n then
      local parts = {}
      for i = 1, t.n do parts[#parts + 1] = t["c" .. i] or "" end
      local d = decode(table.concat(parts))
      if d and (not best or (d.saved or 0) > (best.saved or 0)) then best = d end
    end
  end
  if best then data = best end
  data.players = data.players or {}
  data.chat = data.chat or {}
  data.heat = data.heat or {}
  data.dims = data.dims or {}
  data.inv = data.inv or {}
  data.inv.dir = data.inv.dir or {}
  data.inv.chest = data.inv.chest or {}
  for _, p in pairs(data.players) do p.online = false end
  -- repair: v2.0/2.1 mis-parsed chat events and stored UUIDs as player names
  local uu = "^%x+%-%x+%-%x+%-%x+%-%x+$"
  local clean = {}
  for _, e in ipairs(data.chat) do
    if not tostring(e[3]):match(uu) then clean[#clean + 1] = e end
  end
  data.chat = clean
  for name in pairs(data.players) do
    if tostring(name):match(uu) then data.players[name] = nil; data.heat[name] = nil end
  end
end

