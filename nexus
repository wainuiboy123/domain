local function stamp(rows)
  local h, w = #rows, 0
  for _, r in ipairs(rows) do w = max(w, #r) end
  local oy, ox = floor((16 - h) / 2), floor((16 - w) / 2)
  local g = {}
  for y = 1, 16 do g[y] = {}; for x = 1, 16 do g[y][x] = "." end end
  for y, r in ipairs(rows) do
    for x = 1, #r do
      local ch = r:sub(x, x)
      local yy, xx = y + oy, x + ox
      if ch ~= "." and yy >= 1 and yy <= 16 and xx >= 1 and xx <= 16 then g[yy][xx] = ch end
    end
  end
  return g
end

local icache = {}
function itemIcon(name, bgIdx)
  local key = name .. ":" .. bgIdx
  local cached = icache[key]
  if cached then return cached end
  local path = (name:gsub("^.-:", "")):lower()
  local shape = classify(path)
  local base = matColor(path, name)
  local accent = 0xffffff
  if shape == "ore" then
    accent = base
    if path:find("deepslate") then base = 0x4a4a50 elseif path:find("nether") then base = 0x6f2f2f else base = 0x8a8a8a end
  elseif shape == "bucket" then
    accent = (path:find("water") and 0x3f76e4) or (path:find("lava") and 0xff6a00) or (path:find("milk") and 0xf4f4f4) or 0x2a2a2a
    base = 0xc8c8c8
  elseif shape == "bottle" then
    accent = path:find("water") and 0x3f76e4 or hashRGB(name)
    base = 0xb0e0f0
  elseif shape == "rod" and path:find("stick") then
    base = 0x9c7a46
  end
  local g = stamp(TPL[shape])
  if shape == "ore" then
    for y = 1, 16 do for x = 1, 16 do
      if g[y][x] == "a" and ((x * 5 + y * 11) % 7 == 0 or (x + y * 3) % 11 == 0) then g[y][x] = "x" end
    end end
  elseif shape == "letter" then
    local f = FONTP[path:sub(1, 1):upper()]
    if f then
      local lx0, ly0 = floor((16 - f.w) / 2) + 1, 5
      for r, pat in ipairs(f.rows) do
        for c = 1, #pat do
          if pat:sub(c, c) == "#" then
            local xx, yy = lx0 + c - 1, ly0 + r - 1
            if xx >= 1 and xx <= 16 and yy >= 1 and yy <= 16 then g[yy][xx] = "w" end
          end
        end
      end
    end
  end
  local cols = { o = shade(base, 0.28), a = base, b = shade(base, 0.62), c = lighten(base, 0.4),
                 h = 0x8b5a2b, H = 0x5e3a1c, x = accent, w = 0xf4f0ea }
  local cc = {}
  local rows = {}
  for y = 1, 16 do
    local t = {}
    for x = 1, 16 do
      local ch = g[y][x]
      local idx = bgIdx
      if ch ~= "." and cols[ch] then
        idx = cc[ch]
        if not idx then idx = colorIndex(cols[ch]); cc[ch] = idx end
      end
      t[x] = string.char(idx)
    end
    rows[y] = table.concat(t)
  end
  icache[key] = rows
  return rows
end
