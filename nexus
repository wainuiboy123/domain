local gcache = {}
function glyph(ch, sc, fg, bg)
  local key = ch .. sc .. ":" .. fg .. ":" .. bg
  local g = gcache[key]
  if g then return g end
  local f = FONTP[ch] or FONTP["?"]
  local fgc, bgc = string.char(fg), string.char(bg)
  local rows = {}
  for r = 0, 8 do
    local pat = f.rows[r - f.t + 1]
    local parts = {}
    for c = 1, f.w do
      parts[c] = string.rep((pat and pat:sub(c, c) == "#") and fgc or bgc, sc)
    end
    parts[#parts + 1] = string.rep(bgc, sc)
    local line = table.concat(parts)
    for _ = 1, sc do rows[#rows + 1] = line end
  end
  g = { rows = rows }
  gcache[key] = g
  return g
end
end -- do (font)

local function textW(s, sc)
  sc = sc or 1
  local w = 0
  for i = 1, #s do
    local f = FONTP[s:sub(i, i)] or FONTP["?"]
    w = w + (f.w + 1) * sc
  end
  return w
end

local function fit(s, maxw, sc)
  s = tostring(s)
  if textW(s, sc) <= maxw then return s end
  while #s > 1 and textW(s .. "..", sc) > maxw do s = s:sub(1, -2) end
  return s .. ".."
end

local function text(x, y, s, fg, bg, sc)
  sc = sc or 1
  s = tostring(s)
  if s == "" then return end
  local n = 9 * sc
  local cols = {}
  for r = 1, n do cols[r] = {} end
  for i = 1, #s do
    local g = glyph(s:sub(i, i), sc, fg, bg)
    for r = 1, n do local rr = cols[r]; rr[#rr + 1] = g.rows[r] end
  end
  local rows = {}
  for r = 1, n do rows[r] = table.concat(cols[r]) end
  x, y = floor(x), floor(y)
  local w = #rows[1]
  if x < 0 or y < 0 or x + w > PXW or y + n > PXH then
    -- clip
    local cx = max(0, x)
    local cut = cx - x
    local keep = min(w - cut, PXW - cx)
    if keep <= 0 or y >= PXH then return end
    local ry0 = max(0, -y)
    local nr = {}
    for r = 1 + ry0, n do
      if y + r - 1 < PXH then nr[#nr + 1] = rows[r]:sub(cut + 1, cut + keep) end
    end
    if #nr == 0 then return end
    put(cx, max(0, y), nr)
    return
  end
  put(x, y, rows)
end
local function ctext(x, w, y, s, fg, bg, sc) text(x + floor((w - textW(s, sc)) / 2), y, s, fg, bg, sc) end
local function rtext(xr, y, s, fg, bg, sc) text(xr - textW(s, sc), y, s, fg, bg, sc) end

local function wrapPx(s, maxw)
  local out, line = {}, ""
  for w0 in s:gmatch("%S+") do
    local word = w0
    while textW(word, 1) > maxw do
      if line ~= "" then out[#out + 1] = line; line = "" end
      local cut = #word
      while cut > 1 and textW(word:sub(1, cut), 1) > maxw do cut = cut - 1 end
      out[#out + 1] = word:sub(1, cut)
      word = word:sub(cut + 1)
    end
    if line == "" then line = word
    elseif textW(line .. " " .. word, 1) <= maxw then line = line .. " " .. word
    else out[#out + 1] = line; line = word end
  end
  if line ~= "" or #out == 0 then out[#out + 1] = line end
  return out
end

-- icons -------------------------------------------------------------
local icon, iconSize
do
local TRI_L = "....#/...##/..###/.####/#####/.####/..###/...##/....#"
local TRI_R = "#..../##.../###../####./#####/####./###../##.../#...."
local function combine(a, b, gap)
  local ra, rb, out = {}, {}, {}
  for r in a:gmatch("[^/]+") do ra[#ra + 1] = r end
  for r in b:gmatch("[^/]+") do rb[#rb + 1] = r end
  for i = 1, #ra do out[i] = ra[i] .. string.rep(".", gap) .. rb[i] end
  return table.concat(out, "/")
end
local ICON = {
  play = TRI_R, left = TRI_L,
  pause = "##.##/##.##/##.##/##.##/##.##/##.##/##.##/##.##/##.##",
  rew = combine(TRI_L, TRI_L, 1), ff = combine(TRI_R, TRI_R, 1),
  start = combine("#/#/#/#/#/#/#/#/#", TRI_L, 1), finish = combine(TRI_R, "#/#/#/#/#/#/#/#/#", 1),
  x = "#...#/.#.#./..#../.#.#./#...#",
  filter = "#########/.#######./..#####../...###.../....#..../....#....",
  lock = ".###./#...#/#...#/#####/##.##/##.##/#####",
  menu = "#######/......./#######/......./#######",
  up = "...#.../..###../.#####./#######", down = "#######/.#####./..###../...#...",
}
function icon(x, y, name, fg, bg, sc)
  sc = sc or 1
  local rows, w = {}, 0
  for r in ICON[name]:gmatch("[^/]+") do rows[#rows + 1] = r; w = max(w, #r) end
  local fgc, bgc = string.char(fg), string.char(bg)
  local out = {}
  for _, r in ipairs(rows) do
    local parts = {}
    for c = 1, w do parts[c] = string.rep(r:sub(c, c) == "#" and fgc or bgc, sc) end
    local line = table.concat(parts)
    for _ = 1, sc do out[#out + 1] = line end
  end
  put(floor(x), floor(y), out)
  return w * sc, #rows * sc
end
function iconSize(name, sc)
  local w, h = 0, 0
  for r in ICON[name]:gmatch("[^/]+") do w = max(w, #r); h = h + 1 end
  return w * (sc or 1), h * (sc or 1)
end
end -- do (icons)

