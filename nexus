    text(ix, cpy + 12, "AREA", C.orange, C.panel)
    text(ix, cpy + 13, math.floor(res.spanX) .. " x " .. math.floor(res.spanZ), C.text, C.panel)
    text(ix, cpy + 14, string.format("%.2f blk/px", 1 / res.scale), C.dim, C.panel)
    text(ix, cpy + 16, "PROGRESS", C.orange, C.panel)
    text(ix, cpy + 17, res.idx .. " / " .. #s, C.text, C.panel)
  elseif res and res.empty then
    ctext(cx0, cw, cy0 + math.floor(chh / 2), "No data in this dimension yet", C.dim, C.bg)
  else
    ctext(cx0, cw, cy0 + math.floor(chh / 2), s and "Playhead is before the first sample" or "No movement data recorded yet", C.dim, C.bg)
  end

  -- legend
