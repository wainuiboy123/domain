-- data model + persistence
--------------------------------------------------------------------
local data = { v = 1, players = {}, chat = {}, heat = {}, dims = {}, saved = 0 }
local dirty, chatVer, startup = false, 0, true
local lastSave, lastSaveBytes, nbtOK = 0, 0, true

local function dimId(name)
  name = name or "minecraft:overworld"
  for i, v in ipairs(data.dims) do if v == name then return i end end
  data.dims[#data.dims + 1] = name
  return #data.dims
end
local function dimShort(i)
  local n = data.dims[i] or "unknown"
  if n:find("overworld") then return "Overworld" end
  if n:find("nether") then return "Nether" end
  if n:find("the_end") then return "The End" end
  local s = n:gsub("^.-:", ""):gsub("_", " ")
  return (s:gsub("^%l", string.upper))
end
local function dimColor(i)
  local n = data.dims[i] or ""
  if n:find("overworld") then return C.green end
  if n:find("nether") then return C.red end
  if n:find("the_end") then return C.purple end
  return C.cyan
end

local function payload(f)
  local out = { v = 1, saved = data.saved, dims = data.dims, players = data.players, chat = {}, heat = {} }
  local nc = #data.chat
  for i = nc - math.floor(nc * f) + 1, nc do out.chat[#out.chat + 1] = data.chat[i] end
  for name, s in pairs(data.heat) do
    local ns, arr = #s, {}
    for i = ns - math.floor(ns * f) + 1, ns do arr[#arr + 1] = s[i] end
    out.heat[name] = arr
  end
  return out
end

local function saveNow()
  data.saved = now()
  if CONFIG.LOCAL_MIRROR then
    local f = fs.open(CONFIG.LOCAL_FILE, "w")
    if f then f.write(textutils.serialiseJSON(data)); f.close() end
  end
  if nbt then
    local f, pj = 1.0, nil
    while true do
      pj = textutils.serialiseJSON(payload(f))
      if #pj <= CONFIG.NBT_BUDGET or f < 0.02 then break end
      f = f * 0.8
    end
    local t, n = {}, 0
    for i = 1, #pj, 30000 do n = n + 1; t["c" .. n] = pj:sub(i, i + 29999) end
    t.n = n
    nbtOK = pcall(nbt.writeTable, t)
    lastSaveBytes = #pj
  end
  dirty = false
  lastSave = now()
end

local function decode(json)
  if not json or json == "" then return nil end
  local ok, t = pcall(textutils.unserialiseJSON, json)
  if ok and type(t) == "table" then return t end
end

local function loadData()
  local best
  if fs.exists(CONFIG.LOCAL_FILE) then
    local f = fs.open(CONFIG.LOCAL_FILE, "r")
    if f then best = decode(f.readAll()); f.close() end
  end
  if nbt then
    local ok, t = pcall(nbt.read)
    if ok and type(t) == "table" and t.n then
      local parts = {}
      for i = 1, t.n do parts[#parts + 1] = t["c" .. i] or "" end
      local d = decode(table.concat(parts))
      if d and (not best or (d.saved or 0) > (best.saved or 0)) then best = d end
    end
  end
  if best then data = best end
  data.players = data.players or {}
  data.chat = data.chat or {}
  data.heat = data.heat or {}
  data.dims = data.dims or {}
  for _, p in pairs(data.players) do p.online = false end
end

--------------------------------------------------------------------
-- tracking logic
--------------------------------------------------------------------
local function logEvent(kind, user, msg)
  data.chat[#data.chat + 1] = { now(), kind, sanitize(user), sanitize(msg) }
  if #data.chat > CONFIG.MAX_CHAT then
    for _ = 1, 100 do table.remove(data.chat, 1) end
  end
  chatVer = chatVer + 1
  dirty = true
end

local function ensurePlayer(name)
  local p = data.players[name]
  if not p then
    p = { online = false, first = now(), seen = now(), x = 0, y = 0, z = 0, dim = dimId() }
    data.players[name] = p
  end
  return p
end

local function setOnline(name)
  local p = ensurePlayer(name)
  if not p.online then
    p.online = true
    if not startup then logEvent("j", name, name .. " joined the game") end
  end
  p.seen = now(); dirty = true
end

local function setOffline(name)
  local p = data.players[name]
  if p and p.online then
    p.online = false; p.seen = now()
    logEvent("l", name, name .. " left the game")
  end
end

local function addSample(name, p, force)
  local s = data.heat[name]
  if not s then s = {}; data.heat[name] = s end
  local last, t = s[#s], now()
  if last and not force then
    local dt = t - last[1]
    local moved = math.abs(last[2] - p.x) + math.abs(last[3] - p.z)
    if dt < CONFIG.SAMPLE_EVERY then return end
    if moved < 1 and dt < 30 and last[4] == p.dim then return end
  end
  s[#s + 1] = { t, p.x, p.z, p.dim }
  if #s > CONFIG.MAX_HEAT then
    local ns = {}
    local half = math.floor(#s / 2)
    for i = 1, half, 2 do ns[#ns + 1] = s[i] end
    for i = half + 1, #s do ns[#ns + 1] = s[i] end
    data.heat[name] = ns
  end
  dirty = true
end

local function poll()
  local ok, list = pcall(detector.getOnlinePlayers)
  if not ok or type(list) ~= "table" then return end
  local set = {}
  for _, name in ipairs(list) do
    set[name] = true
    setOnline(name)
    local ok2, pos = pcall(detector.getPlayerPos, name)
    if ok2 and type(pos) == "table" and pos.x then
      local p = data.players[name]
      p.x, p.y, p.z = math.floor(pos.x), math.floor(pos.y or 0), math.floor(pos.z)
      if pos.dimension then p.dim = dimId(pos.dimension) end
      p.seen = now()
      addSample(name, p)
    end
  end
  for name, p in pairs(data.players) do
    if p.online and not set[name] then setOffline(name) end
  end
  startup = false
end

