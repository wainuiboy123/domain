-- tracking logic
--------------------------------------------------------------------
local function logEvent(kind, user, msg)
  data.chat[#data.chat + 1] = { now(), kind, sanitize(user), sanitize(msg) }
  if #data.chat > CONFIG.MAX_CHAT then
    for _ = 1, 100 do table.remove(data.chat, 1) end
  end
  chatVer = chatVer + 1
  dirty = true
end

local function ensurePlayer(name)
  local p = data.players[name]
  if not p then
    p = { online = false, first = now(), seen = now(), x = 0, y = 0, z = 0, dim = dimId(), pos = false }
    data.players[name] = p
    dirty = true
  end
  return p
end

local function setOnline(name)
  local p = ensurePlayer(name)
  if not p.online then
    p.online = true
    if not startup then logEvent("j", name, name .. " joined the game") end
  end
  p.seen = now(); dirty = true
end

local function setOffline(name)
  local p = data.players[name]
  if p and p.online then
    p.online = false; p.seen = now(); p.stale = nil
    logEvent("l", name, name .. " left the game")
  end
end

local function addSample(name, p, force)
  local s = data.heat[name]
  if not s then s = {}; data.heat[name] = s end
  local last, t = s[#s], now()
  if last and not force then
    local dt = t - last[1]
    local moved = math.abs(last[2] - p.x) + math.abs(last[3] - p.z)
    if dt < CONFIG.SAMPLE_EVERY then return end
    if moved < 1 and dt < 30 and last[4] == p.dim then return end
  end
  s[#s + 1] = { t, p.x, p.z, p.dim }
  if #s > CONFIG.MAX_HEAT then
    local ns, half = {}, floor(#s / 2)
    for i = 1, half, 2 do ns[#ns + 1] = s[i] end
    for i = half + 1, #s do ns[#ns + 1] = s[i] end
    data.heat[name] = ns
  end
  dirty = true
end

-- position reading with diagnostics --------------------------------
local function rawStr(v)
  if v == nil then return "nil" end
  local ok, s = pcall(textutils.serialise, v, { compact = true })
  if not ok then s = tostring(v) end
  return sanitize(s):sub(1, 400)
end

local function readPos(name)
  local lastRaw
  for _, fname in ipairs({ "getPlayerPos", "getPlayer" }) do
    local fn = detector[fname]
    if type(fn) == "function" then
      local ok, res = pcall(fn, name)
      if ok and type(res) == "table" then
        local x, y, z = res.x or res.X or res.posX, res.y or res.Y or res.posY, res.z or res.Z or res.posZ
        if not x and type(res.pos) == "table" then x, y, z = res.pos.x, res.pos.y, res.pos.z end
        if not x and type(res.position) == "table" then x, y, z = res.position.x, res.position.y, res.position.z end
        x, z = tonumber(x), tonumber(z)
        if x and z then
          return { x = x, y = tonumber(y) or 0, z = z, dimension = res.dimension or res.dim }, fname, res
        end
        lastRaw = res
      elseif not ok then
        diag.err = fname .. ": " .. tostring(res)
        lastRaw = tostring(res)
      else
        lastRaw = res
      end
    end
  end
  return nil, nil, lastRaw
end

local function writeDebug(name)
  local f = fs.open(CONFIG.DEBUG_FILE, "w")
  if not f then return end
  f.writeLine("NEXUS debug  " .. os.date("%Y-%m-%d %H:%M:%S", now()))
  f.writeLine("pixel size: " .. PXW .. "x" .. PXH .. "  chars: " .. W .. "x" .. H)
  f.writeLine("custom palette: " .. tostring(palOK) .. "   string rows: " .. tostring(ROWSTR))
  f.writeLine("detector methods: " .. diag.methods)
  f.writeLine("chat box: " .. tostring(chatBox ~= nil) .. "  nbt storage: " .. tostring(nbt ~= nil))
  f.writeLine("last touch: " .. diag.touch)
  f.writeLine("nbt: " .. nbtName .. " methods: " .. diag.nbtMethods .. "  error: " .. diag.nbtErr)
  f.writeLine("last chat event: " .. diag.chatRaw)
  for _, n in ipairs(peripheral.getNames()) do
    if n:match("^inventory_manager") then
      local ok, m = pcall(peripheral.getMethods, n)
      f.writeLine("inventory manager " .. n .. " methods: " .. (ok and table.concat(m, ", ") or "?"))
    end
  end
  if name then
    local pos, how, raw = readPos(name)
    f.writeLine("sample player: " .. name)
    f.writeLine("method used: " .. tostring(how))
    f.writeLine("raw result: " .. rawStr(pos or raw))
  end
  f.writeLine("last detector error: " .. diag.err)
  f.writeLine("last error: " .. diag.lastErr)
  f.close()
end

local debugDone = false

local function listPlayers()
  local ok, list = pcall(detector.getOnlinePlayers)
  if not ok then diag.err = "getOnlinePlayers: " .. tostring(list); return nil end
  if type(list) ~= "table" then diag.err = "getOnlinePlayers returned " .. type(list); return nil end
  local out = {}
  for _, v in pairs(list) do
    if type(v) == "string" then out[#out + 1] = v
    elseif type(v) == "table" then
      local n = v.name or v.username or v.player
      if n then out[#out + 1] = tostring(n) end
    end
  end
  table.sort(out)
  return out
end

local function poll()
  local names = listPlayers()
  if not names then diag.n = 0; diag.ok, diag.fail = 0, 0; return end
  diag.err = ""
  diag.n = #names
  local set, okc, failc = {}, 0, 0
  for i, name in ipairs(names) do
    set[name] = true
    setOnline(name)
    local p = data.players[name]
    local pos, how, raw = readPos(name)
    if i == 1 then diag.raw = name .. " = " .. rawStr(pos and raw or raw) end
    if pos then
      okc = okc + 1
      p.x, p.y, p.z = floor(pos.x), floor(pos.y), floor(pos.z)
      if pos.dimension then p.dim = dimId(pos.dimension) end
      p.pos = true; p.stale = nil; p.seen = now()
      diag.how = how
      addSample(name, p)
    else
      failc = failc + 1
      p.stale = true
    end
    if not debugDone then debugDone = true; writeDebug(name) end
  end
  diag.ok, diag.fail = okc, failc
  for name, p in pairs(data.players) do
    if p.online and not set[name] then setOffline(name) end
  end
  startup = false
end

--------------------------------------------------------------------
-- REMOTE INVENTORY  (Advanced Peripherals Inventory Managers)
--------------------------------------------------------------------
-- slot numbers used everywhere below are Minecraft inventory indexes:
--   0-8 hotbar, 9-35 main, 36 boots, 37 legs, 38 chestplate, 39 helmet, 40 offhand
local inv = { mgrs = {}, owners = {}, cands = {}, sel = nil, cache = {}, pick = nil,
              mpage = 0, crow = 0, flash = nil, scanT = 0, methods = {} }
local DIRS, chestFor, invRefresh, invItemAt, invMove
do
DIRS = { "auto", "up", "down", "north", "south", "east", "west", "left", "right", "front", "back" }
local AUTODIRS = { "up", "down", "north", "south", "east", "west" }

local function natKey(s) return (s:gsub("%d+", function(d) return string.format("%08d", tonumber(d)) end)) end

local function invFlash(msg, ok) inv.flash = { msg = sanitize(msg), ok = ok, t = now() } end

local function norm(it)
  if type(it) ~= "table" then return nil end
  local n = it.name
  if type(n) ~= "string" or n == "" or n == "minecraft:air" then return nil end
  local c = tonumber(it.count) or 1
  if c <= 0 then return nil end
  return { name = n, count = c, disp = it.displayName and sanitize(it.displayName) or nil, slot = tonumber(it.slot) }
end

local function isInventoryP(n)
  if n:match("^inventory_manager") then return false end
  local okt, ti = pcall(function() return { peripheral.getType(n) } end)
  if okt then
    for _, t in ipairs(ti) do if t == "inventory_manager" or t == "inventoryManager" then return false end end
    for _, t in ipairs(ti) do if t == "inventory" then return true end end
  end
  local ok, m = pcall(peripheral.getMethods, n)
  if ok and type(m) == "table" then
    local a, b = false, false
    for _, x in ipairs(m) do if x == "list" then a = true elseif x == "size" then b = true end end
    return a and b
  end
  return false
end

-- new Advanced Peripherals returns (uuid, username) from getOwner, old ones just the username
local function ownerOf(name)
  local ok, a, b = pcall(peripheral.call, name, "getOwner")
  if not ok then return nil end
  local o = (type(b) == "string" and b ~= "") and b or a
  if type(o) == "string" and o ~= "" then return o end
  return nil
end

local function invScan()
  local out, cands = {}, {}
  for _, n in ipairs(peripheral.getNames()) do
    local isM = n:match("^inventory_manager") ~= nil
    if not isM then
      local ok, ts = pcall(function() return { peripheral.getType(n) } end)
      if ok then for _, t in ipairs(ts) do if t == "inventory_manager" or t == "inventoryManager" then isM = true end end end
    end
    if isM then out[#out + 1] = n
    elseif isInventoryP(n) then cands[#cands + 1] = n end
  end
  table.sort(out, function(a, b) return natKey(a) < natKey(b) end)
  table.sort(cands, function(a, b) return natKey(a) < natKey(b) end)
  inv.mgrs, inv.cands = out, cands
  for _, n in ipairs(out) do
    inv.owners[n] = ownerOf(n) or false
  end
end

function chestFor(mgr)
  local c = data.inv.chest[mgr]
  if c and peripheral.isPresent(c) then return c end
  if #inv.cands == 1 then return inv.cands[1] end
  return nil
end

local function mgrMethods(name)
  local m = inv.methods[name]
  if m then return m end
  m = {}
  local ok, list = pcall(peripheral.getMethods, name)
  if ok and type(list) == "table" then for _, x in ipairs(list) do m[x] = true end end
  inv.methods[name] = m
  return m
end

local function invLoad()
  local name = inv.sel
  if not name then return end
  local st = inv.cache[name]
  if not st then st = { slots = {}, held = {} }; inv.cache[name] = st end
  st.owner = ownerOf(name)
  st.err = nil
  if not st.owner then
    st.err = "NO MEMORY CARD (OR OWNER OFFLINE)"
    st.slots, st.held, st.heldInfo = {}, {}, nil
  else
    local mm = mgrMethods(name)
    local fnItems = (mm.getItems and "getItems") or (mm.list and "list") or "getItems"
    local okI, items = pcall(peripheral.call, name, fnItems)
    if not okI or type(items) ~= "table" then
      st.err = "PLAYER NOT REACHABLE: " .. sanitize(tostring(items)):sub(1, 80)
      st.slots, st.held, st.heldInfo = {}, {}, nil
    else
      local slots = {}
      -- list() is a CC-style map keyed by slot, 1-based unless a slot 0 shows up
      local base = 0
      if fnItems == "list" then
        base = 1
        for k in pairs(items) do if k == 0 then base = 0 end end
      end
      st.base = base
      for k, it in pairs(items) do
        local n = norm(it)
        if n then
          local s = n.slot
          if s == nil and type(k) == "number" then s = k - base end
          if s then
            if s >= 100 and s <= 103 then s = 36 + (s - 100) end
            slots[s] = n
          end
        end
      end
      -- armour
      local okA, arm = pcall(peripheral.call, name, "getArmor")
      if okA and type(arm) == "table" then
        for i, it in pairs(arm) do
          local n = norm(it)
          if n then
            local s = n.slot
            local idx
            if s then
              if s >= 100 then idx = s - 100 elseif s >= 36 then idx = s - 36 else idx = s end
            else
              idx = (type(i) == "number") and (i - 1) or 0
            end
            idx = clamp(idx, 0, 3)
            if not slots[36 + idx] then slots[36 + idx] = n end
          end
        end
      end
      -- offhand
      for _, fname in ipairs({ "getItemInOffHand", "getOffHand" }) do
        if not slots[40] then
          local okO, off = pcall(peripheral.call, name, fname)
          if okO then local n = norm(off); if n then slots[40] = n end end
        end
      end
      -- which hotbar slot is held
      local held, hinfo, ambig = {}, nil, false
      local m = mgrMethods(name)
      local selSlot, rawSel
      for _, fname in ipairs({ "getSelectedSlot", "getHeldSlot", "getHandSlot", "getCurrentSlot" }) do
        if m[fname] and not selSlot then
          local okS, v = pcall(peripheral.call, name, fname)
          if okS and type(v) == "number" and v >= 0 and v <= 9 then rawSel = v end
        end
      end
      local okH, hi = pcall(peripheral.call, name, "getItemInHand")
      local hn = okH and norm(hi) or nil
      if rawSel then
        -- may be 0- or 1-based depending on version: prefer whichever matches the held item
        local c1, c2 = rawSel, rawSel - 1
        if base == 1 then c1, c2 = rawSel - 1, rawSel end
        for _, c in ipairs({ c1, c2 }) do
          if not selSlot and c >= 0 and c <= 8 and hn and slots[c] and slots[c].name == hn.name then selSlot = c end
        end
        if not selSlot and c1 >= 0 and c1 <= 8 then selSlot = c1 end
      end
      if selSlot then
        held[selSlot] = true; hinfo = slots[selSlot] or hn
      elseif hn then
        local cands = {}
        for s = 0, 8 do
          local it = slots[s]
          if it and it.name == hn.name and it.count == hn.count then cands[#cands + 1] = s end
        end
        for _, s in ipairs(cands) do held[s] = true end
        ambig = #cands > 1
        hinfo = hn
      end
      st.slots, st.held, st.heldInfo, st.heldAmbig, st.when = slots, held, hinfo, ambig, now()
    end
  end
  -- connected chest
  local cname = chestFor(name)
  st.cerr = nil
  if cname then
    local ok1, l = pcall(peripheral.call, cname, "list")
    local ok2, sz = pcall(peripheral.call, cname, "size")
    if ok1 and type(l) == "table" then
      local ci, hi = {}, 0
      for s, it in pairs(l) do
        if type(it) == "table" then ci[s] = { name = it.name, count = it.count or 1 }; hi = max(hi, s) end
      end
      st.chest = { name = cname, size = (ok2 and tonumber(sz)) or max(27, hi), items = ci }
    else
      st.chest = nil; st.cerr = sanitize(tostring(l)):sub(1, 60)
    end
  else
    st.chest = nil
  end
end

function invRefresh(forceScan)
  local ok, err = pcall(function()
    if forceScan or now() - inv.scanT >= 3 or #inv.mgrs == 0 then invScan(); inv.scanT = now() end
    local has = false
    for _, n in ipairs(inv.mgrs) do if n == inv.sel then has = true end end
    if not has then inv.sel = inv.mgrs[1]; inv.pick = nil end
    invLoad()
  end)
  if not ok then logErr("inv: " .. tostring(err)) end
end

-- moving items -------------------------------------------------------
local function callMove(mgr, fn, dir, filter)
  local mm = mgrMethods(mgr)
  local function try(f, ...)
    local ok, r, e = pcall(peripheral.call, mgr, f, ...)
    if ok then
      if type(r) == "number" then return r end
      return 0, tostring(e or r)
    end
    return nil, tostring(r)
  end
  if mm.pushItems and not mm[fn] then                   -- newer Advanced Peripherals
    local f = (fn == "removeItemFromPlayer") and "pushItems" or "pullItems"
    local target = dir
    if not tostring(dir):find("^@") and not peripheral.isPresent(dir) then target = "@" .. dir end
    return try(f, target, { fromSlot = filter.fromSlot, count = filter.count })
  end
  local n, err = try(fn, dir, filter)                   -- Advanced Peripherals 0.7.x (filter table)
  if n == nil and filter.fromSlot then                  -- older versions: (dir, count, slot)
    n, err = try(fn, dir, filter.count, filter.fromSlot)
  end
  return n, err
end

local function transfer(mgr, fn, filter)
  local d = data.inv.dir[mgr] or "auto"
  local dirs = {}
  for _, v in ipairs((d == "auto") and AUTODIRS or { d }) do dirs[#dirs + 1] = v end
  local cn = chestFor(mgr)
  if cn then dirs[#dirs + 1] = cn end            -- newer versions can also move by peripheral name
  local lastErr = "no inventory touching the manager on that side?"
  for _, dir in ipairs(dirs) do
    local n, err = callMove(mgr, fn, dir, filter)
    if n and n > 0 then
      if d == "auto" and dir ~= cn then data.inv.dir[mgr] = dir; dirty = true end   -- remember what worked
      return n
    end
    if err and err ~= "" then lastErr = err end
  end
  return 0, lastErr
end

function invItemAt(st, side, slot)
  if not st then return nil end
  if side == "p" then return st.slots[slot] end
  return st.chest and st.chest.items[slot] or nil
end

function invMove(mode)
  local mgr, pk = inv.sel, inv.pick
  local st = mgr and inv.cache[mgr]
  if not st or not pk then return end
  local it = invItemAt(st, pk.side, pk.slot)
  if not it then inv.pick = nil; return end
  local cnt = (mode == "one") and 1 or (mode == "half" and max(1, floor(it.count / 2)) or it.count)
  local n, err
  if pk.side == "p" then
    n, err = transfer(mgr, "removeItemFromPlayer", { fromSlot = pk.slot + (st.base or 0), count = cnt })
  else
    local cb = (st.base == 1) and 1 or CONFIG.AP_SLOT_BASE   -- new API: chest slots are 1-based
    n, err = transfer(mgr, "addItemToPlayer", { fromSlot = pk.slot - 1 + cb, count = cnt })
  end
  if n > 0 then
    invFlash("MOVED " .. n .. "x " .. (it.disp or (it.name:gsub("^.-:", ""))), true)
  else
    invFlash("FAILED: " .. tostring(err), false)
  end
  invRefresh(false)
  if not invItemAt(inv.cache[mgr], pk.side, pk.slot) then inv.pick = nil end
end

end -- do (inventory)
