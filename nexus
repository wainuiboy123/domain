-- data model + persistence
--------------------------------------------------------------------
local data = { v = 1, players = {}, chat = {}, heat = {}, dims = {}, saved = 0 }
local dirty, chatVer, startup = false, 0, true
local lastSave, lastTry, lastSaveBytes, nbtOK = 0, 0, 0, true
local nbtBudget = CONFIG.NBT_BUDGET

local function dimId(name)
  name = name or "minecraft:overworld"
  for i, v in ipairs(data.dims) do if v == name then return i end end
  data.dims[#data.dims + 1] = name
  return #data.dims
end
local function dimShort(i)
  local n = data.dims[i] or "unknown"
  if n:find("overworld") then return "Overworld" end
  if n:find("nether") then return "Nether" end
  if n:find("the_end") then return "The End" end
  local s = n:gsub("^.-:", ""):gsub("_", " ")
  return (s:gsub("^%l", string.upper))
end

local function payload(f)
  local out = { v = 1, saved = data.saved, dims = data.dims, players = data.players, chat = {}, heat = {} }
  local nc = #data.chat
  for i = nc - floor(nc * f) + 1, nc do out.chat[#out.chat + 1] = data.chat[i] end
  for name, s in pairs(data.heat) do
    local ns, arr = #s, {}
    for i = ns - floor(ns * f) + 1, ns do arr[#arr + 1] = s[i] end
    out.heat[name] = arr
  end
  return out
end

local function saveInner()
  data.saved = now()
  diag.saveErr = ""
  if CONFIG.LOCAL_MIRROR then
    local js = textutils.serialiseJSON(data)
    local f = fs.open(CONFIG.LOCAL_FILE, "w")
    if f then f.write(js); f.close(); diag.localBytes = #js
    else diag.saveErr = "cannot write " .. CONFIG.LOCAL_FILE end
  end
  if nbt then
    for _ = 1, 8 do
      local f, pj = 1.0, nil
      while true do
        pj = textutils.serialiseJSON(payload(f))
        if #pj <= nbtBudget or f < 0.02 then break end
        f = f * 0.8
      end
      local t, n = {}, 0
      for i = 1, #pj, 30000 do n = n + 1; t["c" .. n] = pj:sub(i, i + 29999) end
      t.n = n
      local ok, res = pcall(nbt.writeTable, t)
      if ok and res ~= false then
        nbtOK = true; diag.nbtErr = ""; lastSaveBytes = #pj
        break
      end
      -- the NBT Storage refused it (too big?) - shrink the budget and retry
      nbtOK = false
      diag.nbtErr = ok and "write refused (too big?)" or tostring(res)
      nbtBudget = max(1000, floor(nbtBudget * 0.7))
    end
  end
  dirty = false
  lastSave = now()
end
local function saveNow()
  lastTry = now()
  local ok, err = pcall(saveInner)
  if not ok then diag.saveErr = tostring(err); logErr("save: " .. tostring(err)) end
end

local function decode(json)
  if not json or json == "" then return nil end
  local ok, t = pcall(textutils.unserialiseJSON, json)
  if ok and type(t) == "table" then return t end
end

local function loadData()
  local best
  if fs.exists(CONFIG.LOCAL_FILE) then
    local f = fs.open(CONFIG.LOCAL_FILE, "r")
    if f then best = decode(f.readAll()); f.close() end
  end
  if nbt then
    local ok, t = pcall(nbt.read)
    if ok and type(t) == "table" and t.n then
      local parts = {}
      for i = 1, t.n do parts[#parts + 1] = t["c" .. i] or "" end
      local d = decode(table.concat(parts))
      if d and (not best or (d.saved or 0) > (best.saved or 0)) then best = d end
    end
  end
  if best then data = best end
  data.players = data.players or {}
  data.chat = data.chat or {}
  data.heat = data.heat or {}
  data.dims = data.dims or {}
  for _, p in pairs(data.players) do p.online = false end
end

