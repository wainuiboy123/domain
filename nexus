-- style: solid | outline | danger | dangero | ghost
local function btn(id, x, y, w, h, label, style, d, bgc, sc)
  style = style or "outline"; bgc = bgc or K1; sc = sc or 1
  local fg
  if style == "solid" then rect(x, y, w, h, O4); fg = K0
  elseif style == "danger" then rect(x, y, w, h, RD); fg = K0
  elseif style == "dangero" then rect(x, y, w, h, RD); rect(x + 1, y + 1, w - 2, h - 2, bgc); fg = RD
  elseif style == "ghost" then rect(x, y, w, h, bgc); fg = O5
  else rect(x, y, w, h, O3); rect(x + 1, y + 1, w - 2, h - 2, bgc); fg = O5 end
  local bg = (style == "solid" and O4) or (style == "danger" and RD) or bgc
  label = fit(label, w - 6, sc)
  text(x + floor((w - textW(label, sc)) / 2), y + floor((h - 7 * sc) / 2), label, fg, bg, sc)
  addHit(id, x, y, w, h, d)
end

local function iconBtn(id, x, y, w, h, name, fg, bg, d, sc)
  rect(x, y, w, h, bg)
  local iw, ih = iconSize(name, sc or 1)
  icon(x + floor((w - iw) / 2), y + floor((h - ih) / 2), name, fg, bg, sc or 1)
  addHit(id, x, y, w, h, d)
end

local function scrollbar(id, x, y, h, total, vis, pos)
  rect(x, y, 5, h, K2)
  local th, ty = h, y
  if total > vis then
    th = max(14, floor(h * vis / total))
    ty = y + floor((h - th) * clamp(pos, 0, total - vis) / (total - vis))
  end
  rect(x, ty, 5, th, O3)
  SB[id] = { y = y, h = h, ty = ty, th = th, total = total, vis = vis }
  addHit(id, x - 16, y, 38, h)
end

