local function matColor(path, full)
  for _, m in ipairs(MATS) do if path:find(m[1], 1, true) then return m[2] end end
  return hashRGB(full)
end

local function classify(p)
  if p:find("pickaxe") then return "pickaxe" end
  if p:find("sword") or p:find("katana") or p:find("saber") or p:find("dagger") then return "sword" end
  if p:match("_axe$") or p == "axe" then return "axe" end
  if p:find("shovel") then return "shovel" end
  if p:match("_hoe$") then return "hoe" end
  if p:find("helmet") then return "helmet" end
  if p:find("chestplate") then return "chest" end
  if p:find("leggings") then return "legs" end
  if p:find("boots") then return "boots" end
  if p:find("bucket") then return "bucket" end
  if p:find("potion") or p:find("bottle") or p:find("vial") then return "bottle" end
  if p:match("_ore$") or p == "ore" then return "ore" end
  if p:find("ingot") or p:match("_bar$") then return "ingot" end
  if p:find("nugget") or p:find("^raw_") or p:find("scrap") then return "nugget" end
  if p:find("dust") or p:find("powder") or p:match("dye$") or p == "redstone" or p == "sugar" then return "dust" end
  if p:find("stick") or p:find("rod") or p:find("arrow") then return "rod" end
  if p:match("diamond$") or p:match("emerald$") or p:find("shard") or p:find("crystal") or p:find("gem")
     or p:match("quartz$") or p:find("lapis") or p:find("pearl") then return "gem" end
  if p:find("apple") or p:find("bread") or p:find("carrot") or p:find("potato") or p:find("beef")
     or p:find("porkchop") or p:find("chicken") or p:find("mutton") or p:match("cod$") or p:find("salmon")
     or p:find("melon") or p:find("cookie") or p:find("pie") or p:find("berries") or p:find("beetroot")
     or p:find("stew") or p:find("steak") then return "food" end
  if p:find("block") or p:find("planks") or p:match("_log$") or p:find("^log") or p:match("wood$")
     or p:find("stone") or p:find("brick") or p:find("dirt") or p:find("glass") or p:find("slab")
     or p:find("stairs") or p:find("casing") or p:find("wool") or p:find("concrete") or p:find("terracotta")
     or p:find("sand") or p:find("gravel") or p:find("cobble") or p:find("deepslate") or p:find("andesite")
     or p:find("diorite") or p:find("granite") or p:find("netherrack") or p:find("obsidian")
     or p:find("leaves") or p:find("clay") or p:find("grass") or p:find("ice") or p:find("fence")
     or p:find("door") or p:find("chest") or p:find("barrel") or p:find("furnace") or p:find("table") then
    return "block"
  end
  return "letter"
end

local function blockTpl(n)
  local rows = {}
  for y = 1, n do
    local r = {}
    for x = 1, n do
      local ch
      if y == 1 or y == n or x == 1 or x == n then ch = "o"
      elseif y == 2 or x == 2 then ch = "c"
      elseif y == n - 1 or x == n - 1 then ch = "b"
      else ch = "a" end
      r[x] = ch
    end
    rows[y] = table.concat(r)
  end
  return rows
end

