--------------------------------------------------------------------
-- chat filtering
--------------------------------------------------------------------
local function matchChat(e, n, mid)
  if e[2] ~= "c" then
    if not cs.events then return false end
    if cs.len > 1 then return false end
  end
  if next(cs.users) and not cs.users[e[3]] then return false end
  local t = e[1]
  local dl = DAYS[cs.day]
  if dl == "Today" then if t < mid then return false end
  elseif dl == "Yesterday" then if t >= mid or t < mid - 86400 then return false end
  elseif dl == "Last 7 days" then if t < n - 7 * 86400 then return false end
  elseif dl == "Last 30 days" then if t < n - 30 * 86400 then return false end
  elseif cs.day > 5 then
    if os.date("*t", t).wday ~= WD[dl] then return false end
  end
  local tl = cs.time
  if tl == 2 then if t < n - 3600 then return false end
  elseif tl == 3 then if t < n - 6 * 3600 then return false end
  elseif tl > 3 then
    local hr = os.date("*t", t).hour
    if tl == 4 and not (hr >= 5 and hr < 12) then return false end
    if tl == 5 and not (hr >= 12 and hr < 17) then return false end
    if tl == 6 and not (hr >= 17 and hr < 22) then return false end
    if tl == 7 and not (hr >= 22 or hr < 5) then return false end
  end
  if cs.len > 1 and e[2] == "c" then
    local L = #e[4]
    if L < LENR[cs.len][1] or L > LENR[cs.len][2] then return false end
  end
  if cs.q ~= "" and not e[4]:lower():find(cs.q:lower(), 1, true) then return false end
  return true
end

local function buildChat(maxw)
  local key = chatVer .. ":" .. cs.fv .. ":" .. maxw
  if cs.key == key then return end
  cs.key = key
  local n = now()
  local d = os.date("*t", n)
  local mid = n - (d.hour * 3600 + d.min * 60 + d.sec)
  local flt = {}
  for _, e in ipairs(data.chat) do if matchChat(e, n, mid) then flt[#flt + 1] = e end end
  cs.filtered = flt
  local lines = {}
  for _, e in ipairs(flt) do
    local content, nl, col
    if e[2] == "c" then content = "<" .. e[3] .. "> " .. e[4]; nl = #e[3] + 2; col = WH
    else content = e[4]; nl = 0; col = YL end
    for i, s in ipairs(wrapPx(content, maxw)) do
      lines[#lines + 1] = { e = e, s = s, first = (i == 1), nl = nl, col = col }
    end
  end
  cs.lines = lines
end
