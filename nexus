    local tpf = floor(hm.tp or tN)
    ctext(x, w, y + 12, fmtDT(tpf) .. ":" .. string.format("%02d", tpf % 60), G2, K0)
  end
  if register then addHit("hseek", x, y - 6, w, 20) end
  -- icon row
  local iy = y + 26
  local function ib(id, name, ix, iw, active)
    rect(ix, iy, iw, 26, K0)
