    btn("menubtn", bx - w, 7, w, 22, "MENU", ui.drawer == "heat" and "solid" or "outline", nil, K0)
  end
end

local function drawFooter()
  rect(0, PXH - FTR, PXW, FTR, K1)
  rect(0, PXH - FTR, PXW, 1, K3)
  local onl = 0
  for _, p in pairs(data.players) do if p.online then onl = onl + 1 end end
  rect(M, PXH - 11, 5, 5, onl > 0 and O4 or K3)
  local parts = onl .. " ONLINE"
  text(M + 12, PXH - 13, parts, G2, K1)
  local x = M + 12 + textW(parts, 1) + 22
  local sv = (lastSave > 0) and ("SAVED " .. ago(lastSave) .. " AGO") or "NOT SAVED YET"
  text(x, PXH - 13, sv, diag.saveErr ~= "" and RD or G1, K1); x = x + textW(sv, 1) + 22
  if nbt then
    local ns = string.format("NBT %.1f/%.1f KB", lastSaveBytes / 1024, nbtBudget / 1024)
    text(x, PXH - 13, ns, nbtOK and G1 or RD, K1); x = x + textW(ns, 1) + 22
  end
  local right = "AUTO-LOCK " .. lockRemaining()
  local room = PXW - M - textW(right, 1) - 20 - x
  if diag.err ~= "" then
    text(x, PXH - 13, fit("DETECTOR ERROR: " .. diag.err, room, 1), RD, K1)
  elseif diag.fail > 0 then
    text(x, PXH - 13, fit("NO POSITION DATA FOR " .. diag.fail .. " PLAYER(S) - SEE SYSTEM TAB", room, 1), RD, K1)
  end
  rtext(PXW - M, PXH - 13, right, G1, K1)
end

local function drawApp()
  rect(0, 0, PXW, PXH, K0)
  drawHeader()
  if ui.tab == "tracking" then drawTracking()
  elseif ui.tab == "chat" then drawChat()
  elseif ui.tab == "sys" then drawSystem()
  else drawHeat() end
  if ui.drawer == "filter" and ui.tab == "chat" then drawFilterDrawer()
  elseif ui.drawer == "heat" and ui.tab == "heat" then drawHeatDrawer()
  else ui.drawer = nil end
  drawFooter()
end

local function render()
  hits = {}
  freeze(true)
  local ok, err = pcall(function()
    if ui.locked then drawLock() else drawApp() end
    if ui.modal and not ui.locked then
      hits = {}
      local m = ui.modal
      if m.type == "confirm" then drawConfirm(m)
      elseif m.type == "kbd" then drawKbd(m)
      elseif m.type == "picker" then drawPicker(m) end
    end
  end)
  freeze(false)
  if not ok then logErr("render: " .. tostring(err)) end
end

local function renderHeatFrame()
  if ui.locked or ui.modal or ui.drawer or ui.tab ~= "heat" then return end
  freeze(true)
  local ok, err = pcall(heatDynamic, false)
  freeze(false)
  if not ok then logErr("heat frame: " .. tostring(err)) end
end

