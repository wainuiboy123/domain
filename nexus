local function drawUsers(m)
  local bw, bh = 84, math.min(H - 4, 30)
  local bx, by = math.floor((W - bw) / 2) + 1, math.floor((H - bh) / 2) + 1
  fill(bx - 1, by - 1, bw + 2, bh + 2, C.bg)
