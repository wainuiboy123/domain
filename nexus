local function drawLock()
  fill(1, 1, W, H, C.bg)
  gradientBar(1); gradientBar(H)
  local kh = (H >= 30) and 3 or 1
  local pw = 40
  local ph = 10 + 4 * (kh + 1) + 1
  local px, py = math.floor((W - pw) / 2) + 1, math.floor((H - ph) / 2) + 1
  fill(px - 1, py - 1, pw + 2, ph + 2, C.panel2)
  fill(px, py, pw, ph, C.panel)
  fill(px, py, pw, 1, C.purple)
  ctext(px, pw, py + 2, "N E X U S   T R A C K E R", C.cyan, C.panel)
  ctext(px, pw, py + 3, "secure access terminal", C.dim, C.panel)

  -- pin dots
  local dx = px + math.floor((pw - 4 * 4 + 2) / 2)
  for i = 1, 4 do
    local filled = i <= #ui.pin
    fill(dx + (i - 1) * 4, py + 5, 2, 1, filled and C.cyan or C.panel2)
  end
  local left = ui.lockUntil - now()
  if left > 0 then
    ctext(px, pw, py + 7, "Too many attempts - wait " .. left .. "s", C.red, C.panel)
  else
    ctext(px, pw, py + 7, ui.msg ~= "" and ui.msg or "Enter 4-digit PIN", ui.msg ~= "" and C.red or C.dim, C.panel)
  end

  local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "<" }
  local kw = 8
  local kx0 = px + math.floor((pw - (3 * kw + 2)) / 2)
  for i, k in ipairs(keys) do
    local r, c = math.floor((i - 1) / 3), (i - 1) % 3
    local bg, fg = C.panel2, C.text
    if k == "C" then bg, fg = C.red, C.bg elseif k == "<" then bg, fg = C.orange, C.bg end
    button("pin", kx0 + c * (kw + 1), py + 9 + r * (kh + 1), kw, kh, k, bg, fg, k)
  end
  ctext(px, pw, py + ph - 1, fmtTime(now()), C.dim, C.panel)
end

