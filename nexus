local function sortedPlayers()
  local arr = {}
  for name in pairs(data.players) do arr[#arr + 1] = name end
  table.sort(arr, function(a, b)
    local pa, pb = data.players[a], data.players[b]
    if pa.online ~= pb.online then return pa.online end
    if pa.seen ~= pb.seen then return pa.seen > pb.seen end
    return a:lower() < b:lower()
  end)
  return arr
end

local function drawTracking(x, y, w, h)
  local listW = math.floor(w * 0.64)
  panel(x, y, listW, h, "PLAYER TRACKER", C.blue)
  local names = sortedPlayers()
  local onl = 0
  for _, n in ipairs(names) do if data.players[n].online then onl = onl + 1 end end
  local info = onl .. " online / " .. #names .. " known"
  text(x + listW - #info - 2, y, info, C.dim, C.panel)

  local nameX, coordX, dimX = x + 5, x + 24, x + 50
  text(nameX, y + 1, "PLAYER", C.dim, C.panel)
  text(coordX, y + 1, "COORDINATES", C.dim, C.panel)
  text(dimX, y + 1, "DIMENSION", C.dim, C.panel)

  local rowsVis = math.floor((h - 2 - 3) / 2)
  local maxScroll = math.max(0, #names - rowsVis)
  trk.scroll = clamp(trk.scroll, 0, maxScroll)
  for i = 1, rowsVis do
    local name = names[trk.scroll + i]
    if not name then break end
    local p = data.players[name]
    local ry = y + 2 + (i - 1) * 2
    local sel = (trk.sel == name)
    local bg = sel and C.panel2 or C.panel
    fill(x + 1, ry, listW - 1, 2, bg)
    if sel then fill(x + 1, ry, 1, 2, C.cyan) end
    dot(x + 3, ry, p.online and C.green or C.red)
    text(nameX, ry, trunc(name, 17), userColor(name), bg)
    text(nameX, ry + 1, p.online and "online now" or ("offline " .. ago(p.seen) .. " ago"), C.dim, bg)
    coordLine(coordX, ry, p, bg)
    text(coordX, ry + 1, p.online and "live position" or ("last seen " .. fmtDT(p.seen)), C.dim, bg)
    local dn = " " .. dimShort(p.dim) .. " "
    text(dimX, ry, dn, C.bg, dimColor(p.dim))
    hits[#hits + 1] = { x = x + 1, y = ry, w = listW - 1, h = 2, id = "trkrow", data = name }
  end
  if #names == 0 then ctext(x, listW, y + 6, "No players recorded yet", C.dim, C.panel) end

  -- scroll buttons
  local by = y + h - 3
  button("trkup", x + 2, by, 7, 3, UP, C.panel2, C.cyan)
