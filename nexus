local function heatPlayers()
  local a = {}
  for name, s in pairs(data.heat) do if #s > 0 then a[#a + 1] = name end end
  table.sort(a, function(x, y) return x:lower() < y:lower() end)
  return a
end

local function playerDims(s)
  local seen, out = {}, {}
  for i = 1, #s do
    local d = s[i][4]
    if not seen[d] then seen[d] = true; out[#out + 1] = d end
  end
  return out
end

local function buildHeat(s, tp, dimSel, PW, PH)
  local n = #s
  local lo, hi, idx = 1, n, 0
  while lo <= hi do
    local mid = math.floor((lo + hi) / 2)
    if s[mid][1] <= tp then idx = mid; lo = mid + 1 else hi = mid - 1 end
  end
  if idx == 0 then return nil end
  local dim = dimSel or s[idx][4]
  local minX, maxX, minZ, maxZ, count = math.huge, -math.huge, math.huge, -math.huge, 0
  for i = 1, idx do
    local e = s[i]
    if e[4] == dim then
      count = count + 1
      if e[2] < minX then minX = e[2] end
      if e[2] > maxX then maxX = e[2] end
      if e[3] < minZ then minZ = e[3] end
      if e[3] > maxZ then maxZ = e[3] end
    end
  end
  if count == 0 then return { empty = true, dim = dim, idx = idx } end
  local spanX = math.max(maxX - minX + 1, 48)
  local spanZ = math.max(maxZ - minZ + 1, 48)
  local scale = math.min(PW / spanX, PH / spanZ)
  local g = {}
  local function add(x, z, wgt)
    local c = clamp(math.floor((x - minX) * scale), 0, PW - 1)
    local r = clamp(PH - 1 - math.floor((z - minZ) * scale), 0, PH - 1)
    local k = r * PW + c
    g[k] = (g[k] or 0) + wgt
  end
  local prev
  for i = 1, idx do
    local e = s[i]
    if e[4] == dim then
      if prev and e[1] - prev[1] <= 120 then
        local dt = math.min(e[1] - prev[1], 30)
        local steps = math.max(1, math.ceil(math.max(math.abs(e[2] - prev[2]), math.abs(e[3] - prev[3])) * scale))
        steps = math.min(steps, 400)
        local wgt = dt / (steps + 1)
        for k = 0, steps do
          local f = k / steps
          add(prev[2] + (e[2] - prev[2]) * f, prev[3] + (e[3] - prev[3]) * f, wgt)
        end
      else
        add(e[2], e[3], 1)
      end
      prev = e
    else
      prev = nil
    end
  end
  -- soft glow
  local g2, gmax = {}, 0
  for k, v in pairs(g) do
    g2[k] = (g2[k] or 0) + v
    local c = k % PW
    if c > 0 then g2[k - 1] = (g2[k - 1] or 0) + v * 0.22 end
    if c < PW - 1 then g2[k + 1] = (g2[k + 1] or 0) + v * 0.22 end
    if k >= PW then g2[k - PW] = (g2[k - PW] or 0) + v * 0.22 end
    if k < PW * (PH - 1) then g2[k + PW] = (g2[k + PW] or 0) + v * 0.22 end
  end
  for _, v in pairs(g2) do if v > gmax then gmax = v end end
  local pix, lg = {}, math.log(1 + gmax)
  for k, v in pairs(g2) do
    local ratio = lg > 0 and (math.log(1 + v) / lg) or 1
    pix[k] = HEAT[clamp(math.ceil(ratio * #HEAT), 1, #HEAT)]
  end
  local cur = s[idx]
  local mc, mr
  if cur[4] == dim then
    mc = clamp(math.floor((cur[2] - minX) * scale), 0, PW - 1)
    mr = clamp(PH - 1 - math.floor((cur[3] - minZ) * scale), 0, PH - 1)
    local function mk(c, r, col)
      if c >= 0 and c < PW and r >= 0 and r < PH then pix[r * PW + c] = col end
    end
    mk(mc - 1, mr, C.text); mk(mc + 1, mr, C.text); mk(mc, mr - 1, C.text); mk(mc, mr + 1, C.text)
    mk(mc, mr, C.pink)
  end
  return { pix = pix, idx = idx, dim = dim, minX = minX, minZ = minZ,
           maxX = minX + spanX - 1, maxZ = minZ + spanZ - 1,
           spanX = spanX, spanZ = spanZ, scale = scale, cur = cur }
end

-- draws a 2x3 sub-pixel grid using teletext characters
local function drawPixelGrid(x0, y0, cw, chh, pix, PW)
  local blit = colors.toBlit
  local bgc0 = C.bg
  for cy = 0, chh - 1 do
    local chars, fgs, bgs = {}, {}, {}
    for cx = 0, cw - 1 do
      local bx, by = cx * 2, cy * 3
      local p = {
        pix[by * PW + bx] or bgc0,       pix[by * PW + bx + 1] or bgc0,
        pix[(by + 1) * PW + bx] or bgc0, pix[(by + 1) * PW + bx + 1] or bgc0,
        pix[(by + 2) * PW + bx] or bgc0, pix[(by + 2) * PW + bx + 1] or bgc0,
      }
      local bgc = p[6]
      local fgc, best = bgc, -1
      for i = 1, 5 do
        if p[i] ~= bgc then
          local r = RANK[p[i]] or 0
          if r > best then best = r; fgc = p[i] end
        end
      end
      local code = 128
      for i = 1, 5 do
        if p[i] ~= bgc then code = code + 2 ^ (i - 1) end
      end
      chars[#chars + 1] = string.char(code)
      fgs[#fgs + 1] = blit(fgc)
      bgs[#bgs + 1] = blit(bgc)
    end
    win.setCursorPos(x0, y0 + cy)
    win.blit(table.concat(chars), table.concat(fgs), table.concat(bgs))
  end
end

