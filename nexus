-- pixel backend
--------------------------------------------------------------------
local ROWSTR = pcall(mon.drawPixels, 0, 0, { string.char(K0) })
local function freeze(b) pcall(mon.setFrozen, b) end

-- Off-screen framebuffer. Everything draws into FB (pure Lua, instant), then
-- commit() pushes only the rows that changed in one or two drawPixels calls.
local FB, SHOWN = {}, {}
do
  local blank = string.rep(string.char(K0), PXW)
  for r = 1, PXH do FB[r] = blank end
end

local function put(x, y, rows)
  x, y = floor(x), floor(y)
  for i = 1, #rows do
    local yy = y + i
    if yy >= 1 and yy <= PXH then
      local str = rows[i]
      local x0 = x
      if x0 < 0 then str = str:sub(1 - x0); x0 = 0 end
      if x0 + #str > PXW then str = str:sub(1, PXW - x0) end
      local len = #str
      if len > 0 then
        if x0 == 0 and len >= PXW then FB[yy] = str
        else FB[yy] = FB[yy]:sub(1, x0) .. str .. FB[yy]:sub(x0 + len + 1) end
      end
    end
  end
end

local function sendRows(first, last)
  local rows = {}
  for r = first, last do
    local str = FB[r]
    if ROWSTR then rows[#rows + 1] = str
    else
      local t = {}
      for j = 1, #str do t[j] = str:byte(j) end
      rows[#rows + 1] = t
    end
  end
  mon.drawPixels(0, first - 1, rows)
end

local function commit()
  freeze(true)
  local r = 1
  while r <= PXH do
    if FB[r] ~= SHOWN[r] then
      local last, gap, q = r, 0, r + 1
      while q <= PXH do               -- bridge tiny unchanged gaps to save calls
        if FB[q] ~= SHOWN[q] then last = q; gap = 0
        else gap = gap + 1; if gap > 6 then break end end
        q = q + 1
      end
      local ok, err = pcall(sendRows, r, last)
      if not ok then logErr("drawPixels: " .. tostring(err)) end
      for k = r, last do SHOWN[k] = FB[k] end
      r = last + 1
    else
      r = r + 1
    end
  end
  freeze(false)
end

local function rect(x, y, w, h, c)
  x, y, w, h = floor(x), floor(y), floor(w), floor(h)
  if x < 0 then w = w + x; x = 0 end
  if y < 0 then h = h + y; y = 0 end
  if x + w > PXW then w = PXW - x end
  if y + h > PXH then h = PXH - y end
  if w <= 0 or h <= 0 then return end
  local str = string.rep(string.char(c), w)
  local rows = {}
  for i = 1, h do rows[i] = str end
  put(x, y, rows)
end

