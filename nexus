              or (hm.follow and "LIVE" or "PAUSED")
  text(x + 208, iy + 9, lab, (hm.playing or hm.follow) and O4 or G1, K0)
  if s and #s > 0 then
    local info = string.upper(hm.player) .. "   " .. #s .. " SAMPLES   " .. fmtDur(max(0, s[#s][1] - s[1][1])) .. " TRACKED"
    rtext(x + w, iy + 9, fit(info, w - 300, 1), G1, K0)
  end
end

function heatDynamic(register)
  local s = hm.player and data.heat[hm.player]
  local res
  if s and #s > 0 then
    local t0, tN = s[1][1], s[#s][1]
    if hm.follow or not hm.tp then hm.tp = tN end
    hm.tp = clamp(hm.tp, t0, tN)
    res = buildHeat(s, hm.tp, hm.dim, HL.PW, HL.PH)
  else
    s = nil
  end
  pushCanvas(res and res.pix and res or nil)
  if res and res.pix then
    local lo = string.format("X%d Z%d", floor(res.minX), floor(res.minZ))
    local hi = string.format("X%d Z%d", floor(res.maxX), floor(res.maxZ))
    text(HL.cx + 3, HL.cy + HL.ch - 11, lo, G1, K0)
    rtext(HL.cx + HL.cw - 3, HL.cy + 3, hi, G1, K0)
    local cur = string.format("%s   X %d   Z %d   GRID %d", dimShort(res.cur[4]), floor(res.cur[2]), floor(res.cur[3]), res.step)
    rtext(HL.cx + HL.cw - 3, HL.cy + HL.ch - 11, cur, O5, K0)
  else
    local msg
    if not s then msg = "NO MOVEMENT DATA RECORDED YET"
    elseif res and res.empty then msg = "NO DATA IN THIS DIMENSION"
    else msg = "PLAYHEAD IS BEFORE THE FIRST SAMPLE" end
    ctext(HL.cx, HL.cw, HL.cy + floor(HL.ch / 2), msg, G1, K0)
  end
  heatControls(register)
end

function drawHeat()
  local list = heatPlayers()
  if not hm.player or not data.heat[hm.player] or #data.heat[hm.player] == 0 then
    hm.player = list[1]; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
  end
  heatLayout()
  rect(HL.cx - 1, HL.cy - 1, HL.cw + 2, HL.ch + 2, K3)
  heatDynamic(true)
end
end -- do (heat-ui)

