--------------------------------------------------------------------
local function logEvent(kind, user, msg)
  data.chat[#data.chat + 1] = { now(), kind, sanitize(user), sanitize(msg) }
  if #data.chat > CONFIG.MAX_CHAT then
    for _ = 1, 100 do table.remove(data.chat, 1) end
  end
  chatVer = chatVer + 1
  dirty = true
end

local function ensurePlayer(name)
  local p = data.players[name]
  if not p then
    p = { online = false, first = now(), seen = now(), x = 0, y = 0, z = 0, dim = dimId(), pos = false }
    data.players[name] = p
    dirty = true
  end
  return p
end

local function setOnline(name)
  local p = ensurePlayer(name)
  if not p.online then
    p.online = true
    if not startup then logEvent("j", name, name .. " joined the game") end
  end
  p.seen = now(); dirty = true
end

local function setOffline(name)
  local p = data.players[name]
  if p and p.online then
    p.online = false; p.seen = now(); p.stale = nil
    logEvent("l", name, name .. " left the game")
  end
end

local function addSample(name, p, force)
  local s = data.heat[name]
  if not s then s = {}; data.heat[name] = s end
  local last, t = s[#s], now()
  if last and not force then
    local dt = t - last[1]
    local moved = math.abs(last[2] - p.x) + math.abs(last[3] - p.z)
    if dt < CONFIG.SAMPLE_EVERY then return end
    if moved < 1 and dt < 30 and last[4] == p.dim then return end
  end
  s[#s + 1] = { t, p.x, p.z, p.dim }
  if #s > CONFIG.MAX_HEAT then
    local ns, half = {}, floor(#s / 2)
    for i = 1, half, 2 do ns[#ns + 1] = s[i] end
    for i = half + 1, #s do ns[#ns + 1] = s[i] end
    data.heat[name] = ns
  end
  dirty = true
end

-- position reading with diagnostics --------------------------------
local function rawStr(v)
  if v == nil then return "nil" end
  local ok, s = pcall(textutils.serialise, v, { compact = true })
  if not ok then s = tostring(v) end
  return sanitize(s):sub(1, 400)
end

local function readPos(name)
  local lastRaw
  for _, fname in ipairs({ "getPlayerPos", "getPlayer" }) do
    local fn = detector[fname]
    if type(fn) == "function" then
      local ok, res = pcall(fn, name)
      if ok and type(res) == "table" then
        local x, y, z = res.x or res.X or res.posX, res.y or res.Y or res.posY, res.z or res.Z or res.posZ
        if not x and type(res.pos) == "table" then x, y, z = res.pos.x, res.pos.y, res.pos.z end
        if not x and type(res.position) == "table" then x, y, z = res.position.x, res.position.y, res.position.z end
        x, z = tonumber(x), tonumber(z)
        if x and z then
          return { x = x, y = tonumber(y) or 0, z = z, dimension = res.dimension or res.dim }, fname, res
        end
        lastRaw = res
      elseif not ok then
        diag.err = fname .. ": " .. tostring(res)
        lastRaw = tostring(res)
      else
        lastRaw = res
      end
    end
  end
  return nil, nil, lastRaw
end

local function writeDebug(name)
  local f = fs.open(CONFIG.DEBUG_FILE, "w")
  if not f then return end
  f.writeLine("NEXUS debug  " .. os.date("%Y-%m-%d %H:%M:%S", now()))
  f.writeLine("pixel size: " .. PXW .. "x" .. PXH .. "  chars: " .. W .. "x" .. H)
  f.writeLine("custom palette: " .. tostring(palOK) .. "   string rows: " .. tostring(ROWSTR))
  f.writeLine("detector methods: " .. diag.methods)
  f.writeLine("chat box: " .. tostring(chatBox ~= nil) .. "  nbt storage: " .. tostring(nbt ~= nil))
  f.writeLine("last touch: " .. diag.touch)
  if name then
    local pos, how, raw = readPos(name)
    f.writeLine("sample player: " .. name)
    f.writeLine("method used: " .. tostring(how))
    f.writeLine("raw result: " .. rawStr(pos or raw))
  end
  f.writeLine("last detector error: " .. diag.err)
  f.writeLine("last error: " .. diag.lastErr)
  f.close()
end

local debugDone = false

local function listPlayers()
  local ok, list = pcall(detector.getOnlinePlayers)
  if not ok then diag.err = "getOnlinePlayers: " .. tostring(list); return nil end
  if type(list) ~= "table" then diag.err = "getOnlinePlayers returned " .. type(list); return nil end
  local out = {}
  for _, v in pairs(list) do
    if type(v) == "string" then out[#out + 1] = v
    elseif type(v) == "table" then
      local n = v.name or v.username or v.player
      if n then out[#out + 1] = tostring(n) end
    end
  end
  table.sort(out)
  return out
end

local function poll()
  local names = listPlayers()
  if not names then diag.n = 0; diag.ok, diag.fail = 0, 0; return end
  diag.err = ""
  diag.n = #names
  local set, okc, failc = {}, 0, 0
  for i, name in ipairs(names) do
    set[name] = true
    setOnline(name)
    local p = data.players[name]
    local pos, how, raw = readPos(name)
    if i == 1 then diag.raw = name .. " = " .. rawStr(pos and raw or raw) end
    if pos then
      okc = okc + 1
      p.x, p.y, p.z = floor(pos.x), floor(pos.y), floor(pos.z)
      if pos.dimension then p.dim = dimId(pos.dimension) end
      p.pos = true; p.stale = nil; p.seen = now()
      diag.how = how
      addSample(name, p)
    else
      failc = failc + 1
      p.stale = true
    end
    if not debugDone then debugDone = true; writeDebug(name) end
  end
  diag.ok, diag.fail = okc, failc
  for name, p in pairs(data.players) do
    if p.online and not set[name] then setOffline(name) end
  end
  startup = false
end

