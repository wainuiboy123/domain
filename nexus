local sampleIndex, activeDuration, buildHeat
do
local STEPS = { 16, 32, 50, 100, 200, 250, 500, 1000, 2000, 5000, 10000, 50000 }

function sampleIndex(s, tp)          -- last sample whose time <= tp
  local lo, hi, idx = 1, #s, 0
  while lo <= hi do
    local mid = floor((lo + hi) / 2)
    if s[mid][1] <= tp then idx = mid; lo = mid + 1 else hi = mid - 1 end
  end
  return idx
end

local function nice(v)                       -- stepped sizes so the view only re-scales now and then
  local n = 64
  while n < v do n = n * 1.25 end
  return floor(n)
end

local ACT = {}
function activeDuration(s)             -- tracked time excluding long idle gaps
  if ACT.s == s and ACT.n == #s then return ACT.dur end
  local d = 0
  for i = 2, #s do
    local g = s[i][1] - s[i - 1][1]
    if g <= 45 then d = d + g end
  end
  ACT = { s = s, n = #s, dur = d }
  return d
end

local HB, HC = {}, {}    -- bounds cache, accumulated heat cache (both incremental)

function buildHeat(s, tp, dimSel, PW, PH)
  local idx = sampleIndex(s, tp)
  if idx == 0 then return nil end
  local dim = dimSel or s[idx][4]

  -- bounds of everything up to the playhead (incremental)
  if HB.s ~= s or HB.dim ~= dim or idx < HB.n then
    HB = { s = s, dim = dim, n = 0, minX = math.huge, maxX = -math.huge,
           minZ = math.huge, maxZ = -math.huge, count = 0 }
  end
  for i = HB.n + 1, idx do
    local e = s[i]
    if e[4] == dim then
      HB.count = HB.count + 1
      if e[2] < HB.minX then HB.minX = e[2] end
      if e[2] > HB.maxX then HB.maxX = e[2] end
      if e[3] < HB.minZ then HB.minZ = e[3] end
      if e[3] > HB.maxZ then HB.maxZ = e[3] end
    end
  end
  HB.n = idx
  if HB.count == 0 then return { empty = true, dim = dim, idx = idx } end

  -- bottom-left = most -X/-Z seen so far; view grows as the player explores
  local minX = floor(HB.minX / 8) * 8
  local minZ = floor(HB.minZ / 8) * 8
  local spanX = nice(HB.maxX - minX + 1)
  local spanZ = nice(HB.maxZ - minZ + 1)
  local scale = min(PW / spanX, PH / spanZ)
  local extX, extZ = PW / scale, PH / scale

  -- accumulate heat incrementally; only rebuilt when the view re-scales or you rewind
  local key = dim .. ":" .. minX .. ":" .. minZ .. ":" .. scale .. ":" .. PW .. ":" .. PH
  if HC.s ~= s or HC.key ~= key or idx < HC.idx then
    HC = { s = s, key = key, idx = 0, g = {}, prev = nil }
  end
  local g = HC.g
  local function add(px, pz, wgt)
    local c = clamp(floor((px - minX) * scale), 0, PW - 1)
    local r = clamp(PH - 1 - floor((pz - minZ) * scale), 0, PH - 1)
    local k = r * PW + c
    g[k] = (g[k] or 0) + wgt
  end
  local prev = HC.prev
  for i = HC.idx + 1, idx do
    local e = s[i]
    if e[4] == dim then
      if prev and e[1] - prev[1] <= 120 then
        local dt = min(e[1] - prev[1], 30)
        local steps = max(1, math.ceil(max(math.abs(e[2] - prev[2]), math.abs(e[3] - prev[3])) * scale))
        steps = min(steps, 150)
        local wgt = dt / (steps + 1)
        for k = 0, steps do
          local f = k / steps
          add(prev[2] + (e[2] - prev[2]) * f, prev[3] + (e[3] - prev[3]) * f, wgt)
        end
      else
        add(e[2], e[3], 1)
      end
      prev = e
    else
      prev = nil
    end
  end
  HC.idx, HC.prev = idx, prev

  local pix = {}
  -- faint coordinate grid (brighter lines at X=0 / Z=0)
  local step = STEPS[#STEPS]
  for _, st in ipairs(STEPS) do if st * scale >= 30 then step = st; break end end
  local x = math.ceil(minX / step) * step
  while x <= minX + extX do
    local c = floor((x - minX) * scale)
    if c >= 0 and c < PW then for r = 0, PH - 1 do pix[r * PW + c] = (x == 0) and K3 or K2 end end
    x = x + step
  end
  local z = math.ceil(minZ / step) * step
  while z <= minZ + extZ do
    local r = PH - 1 - floor((z - minZ) * scale)
    if r >= 0 and r < PH then for c = 0, PW - 1 do pix[r * PW + c] = (z == 0) and K3 or K2 end end
    z = z + step
  end

  -- soften + colour by time spent (log scale so rarely visited spots still show)
  local g2, gmax = {}, 0
  for k, v in pairs(g) do
    g2[k] = (g2[k] or 0) + v
    local c = k % PW
    if c > 0 then g2[k - 1] = (g2[k - 1] or 0) + v * 0.3 end
    if c < PW - 1 then g2[k + 1] = (g2[k + 1] or 0) + v * 0.3 end
    if k >= PW then g2[k - PW] = (g2[k - PW] or 0) + v * 0.3 end
    if k < PW * (PH - 1) then g2[k + PW] = (g2[k + PW] or 0) + v * 0.3 end
  end
  for _, v in pairs(g2) do if v > gmax then gmax = v end end
  local lg = math.log(1 + gmax)
  for k, v in pairs(g2) do
    local ratio = lg > 0 and (math.log(1 + v) / lg) or 1
    pix[k] = HEATC[clamp(math.ceil(ratio * #HEATC), 1, #HEATC)]
  end

  -- player marker
  local cur = s[idx]
  if cur[4] == dim then
    local mc = clamp(floor((cur[2] - minX) * scale), 0, PW - 1)
    local mr = clamp(PH - 1 - floor((cur[3] - minZ) * scale), 0, PH - 1)
    local function mk(c, r, col)
      if c >= 0 and c < PW and r >= 0 and r < PH then pix[r * PW + c] = col end
    end
    for d = 3, 5 do
      mk(mc - d, mr, WH); mk(mc + d, mr, WH); mk(mc, mr - d, WH); mk(mc, mr + d, WH)
    end
    for d = -1, 1 do mk(mc + d, mr, YL); mk(mc, mr + d, YL) end
  end
  return { pix = pix, idx = idx, dim = dim, minX = minX, minZ = minZ,
           maxX = minX + extX, maxZ = minZ + extZ, scale = scale, cur = cur, step = step }
end
end -- do (heat)

local heatDynamic, drawHeat
do
local HL = {}
local PIECE = {}
local function heatLayout()
  local hs = CONFIG.HEAT_PX
  HL.hs = hs
  HL.cx, HL.cy = M, CY0
  HL.PW = floor((PXW - 2 * M) / hs)
  HL.PH = floor((CY1 - CY0 - 64) / hs)
  HL.cw, HL.ch = HL.PW * hs, HL.PH * hs
  HL.ctrlY = HL.cy + HL.ch + 8
end

local function pushCanvas(res)
  local hs, PW, PH = HL.hs, HL.PW, HL.PH
  local pix = res and res.pix or {}
  local touched = {}
  for k in pairs(pix) do touched[floor(k / PW)] = true end
  local blankRow = string.rep(string.char(K0), PW * hs)
  local rows = {}
  for r = 0, PH - 1 do
    local str
    if not touched[r] then
      str = blankRow
    else
      local t, base = {}, r * PW
      for c = 0, PW - 1 do
        local col = pix[base + c] or K0
        local pc = PIECE[col]
        if not pc then pc = string.rep(string.char(col), hs); PIECE[col] = pc end
        t[c + 1] = pc
      end
      str = table.concat(t)
    end
    for _ = 1, hs do rows[#rows + 1] = str end
  end
  put(HL.cx, HL.cy, rows)
end

local function heatControls(register)
  local s = hm.player and data.heat[hm.player]
  local y = HL.ctrlY
  local x, w = M, PXW - 2 * M
  rect(x, y - 4, w, 58, K0)
