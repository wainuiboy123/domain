local cidx = {}

local function rgbSplit(c) return floor(c / 65536) % 256, floor(c / 256) % 256, c % 256 end
local function shade(rgb, f)
  local r, g, b = rgbSplit(rgb)
  return clamp(floor(r * f + 0.5), 0, 255) * 65536 + clamp(floor(g * f + 0.5), 0, 255) * 256 + clamp(floor(b * f + 0.5), 0, 255)
end
local function lighten(rgb, t)
  local r, g, b = rgbSplit(rgb)
  return floor(r + (255 - r) * t) * 65536 + floor(g + (255 - g) * t) * 256 + floor(b + (255 - b) * t)
end

local function nearestDefault(r, g, b)
  local best, bi = math.huge, 0
  for i, c in ipairs(CCDEF) do
    local r2, g2, b2 = rgbSplit(c)
    local d = (r - r2) ^ 2 + (g - g2) ^ 2 + (b - b2) ^ 2
    if d < best then best = d; bi = i - 1 end
  end
  return bi
end

-- gives every distinct colour its own palette slot (quantised to 6 levels/channel)
local function colorIndex(rgb)
  local r, g, b = rgbSplit(rgb)
  local qr, qg, qb = floor(r / 51 + 0.5), floor(g / 51 + 0.5), floor(b / 51 + 0.5)
  local key = qr * 36 + qg * 6 + qb
  local i = cidx[key]
  if i then return i end
  if palOK and poolN < #POOL then
    poolN = poolN + 1
    local idx = POOL[poolN]
    if pcall(mon.setPaletteColor, idx, (qr * 51) * 65536 + (qg * 51) * 256 + (qb * 51)) then
      cidx[key] = idx
      return idx
    end
  end
  local d = nearestDefault(r, g, b)
  cidx[key] = d
  return d
end

local function hashRGB(s)
  local h = 5381
  for i = 1, #s do h = (h * 33 + s:byte(i)) % 2147483647 end
  local hue = (h % 360) / 60
  local sat, val = 0.55, 0.85
  local c = val * sat
  local x = c * (1 - math.abs(hue % 2 - 1))
  local m = val - c
  local r, g, b
  local i = floor(hue)
  if i == 0 then r, g, b = c, x, 0 elseif i == 1 then r, g, b = x, c, 0 elseif i == 2 then r, g, b = 0, c, x
  elseif i == 3 then r, g, b = 0, x, c elseif i == 4 then r, g, b = x, 0, c else r, g, b = c, 0, x end
  return floor((r + m) * 255) * 65536 + floor((g + m) * 255) * 256 + floor((b + m) * 255)
end

