local floor, max, min = math.floor, math.max, math.min
local function now() return floor(os.epoch("utc") / 1000) end
local function clamp(v, a, b) return max(a, min(b, v)) end
local function sanitize(s) return (tostring(s):gsub("[^\32-\126]", "?")) end
local function fmtDT(t) return os.date("%m/%d %H:%M", t) end
local function fmtClock(t) return os.date("%H:%M", t) end
local function ago(t)
  local d = max(0, now() - t)
  if d < 60 then return d .. "s"
  elseif d < 3600 then return floor(d / 60) .. "m"
  elseif d < 86400 then return floor(d / 3600) .. "h"
  else return floor(d / 86400) .. "d" end
end
local function fmtDur(s)
  s = floor(s)
  if s < 60 then return s .. "s" end
  if s < 3600 then return floor(s / 60) .. "m " .. (s % 60) .. "s" end
  return floor(s / 3600) .. "h " .. floor((s % 3600) / 60) .. "m"
end

