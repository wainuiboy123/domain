  fill(bx, by, bw, 1, C.cyan)
  ctext(bx, bw, by, "SELECT USERS  (tap to toggle)", C.bg, C.cyan)
  local users = allUsers()
  local cols = 3
  local cwid = math.floor((bw - 6) / cols)
  local rows = math.floor((bh - 7) / 2)
  local per = rows * cols
  local pages = math.max(1, math.ceil(#users / per))
  m.page = clamp(m.page, 1, pages)
  for i = 1, per do
    local name = users[(m.page - 1) * per + i]
    if not name then break end
    local r, c = math.floor((i - 1) / cols), (i - 1) % cols
    local on = cs.users[name]
    button("upick", bx + 3 + c * cwid, by + 2 + r * 2, cwid - 1, 1,
      (on and "[x] " or "[ ] ") .. name, on and userColor(name) or C.panel2, on and C.bg or userColor(name), name)
  end
  if #users == 0 then ctext(bx, bw, by + 4, "No users recorded yet", C.dim, C.panel) end
  local yy = by + bh - 4
  button("upg-", bx + 3, yy, 7, 3, REWR, C.panel2, C.cyan)
  ctext(bx + 10, 12, yy + 1, m.page .. "/" .. pages, C.dim, C.panel)
  button("upg+", bx + 22, yy, 7, 3, PLAYR, C.panel2, C.cyan)
  button("uclear", bx + bw - 44, yy, 18, 3, "CLEAR ALL", C.red, C.bg)
  button("udone", bx + bw - 24, yy, 21, 3, "DONE", C.green, C.bg)
end

