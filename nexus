  button("hff", x + 34, by, 9, bh, PLAYR .. PLAYR, C.panel2, C.cyan)
  button("hend", x + 44, by, 7, bh, PLAYR .. "|", C.panel2, C.cyan)
  local lab = hm.playing and ((hm.rate < 0 and (REWR .. REWR .. " ") or (PLAYR .. PLAYR .. " ")) .. math.abs(hm.rate) .. "x") or "paused"
