local TABS = {
  { id = "tracking", label = "TRACKING", color = C.blue },
  { id = "chat",     label = "CHAT LOG", color = C.purple },
  { id = "heat",     label = "HEATMAP",  color = C.orange },
}

local function lockRemaining()
  local r = math.max(0, CONFIG.LOCK_AFTER - (now() - ui.lastAct))
  return string.format("%d:%02d", math.floor(r / 60), r % 60)
end

local function drawApp()
  fill(1, 1, W, H, C.bg)
  gradientBar(1)
  fill(1, 2, W, 3, C.panel)
  fill(3, 3, 9, 1, C.cyan)
  text(3, 3, " NEXUS   ", C.bg, C.cyan)
  text(13, 3, "TRACKER", C.text, C.panel)
  text(3, 4, "player intelligence", C.dim, C.panel)
  for i, t in ipairs(TABS) do
    local tx = 28 + (i - 1) * 19
    local active = ui.tab == t.id
    button("tab", tx, 2, 18, 3, t.label, active and t.color or C.panel2, active and C.bg or t.color, t.id)
  end
  button("lock", W - 12, 2, 11, 3, "LOCK", C.red, C.bg)
  text(W - 25, 3, fmtTime(now()), C.text, C.panel)
  text(W - 25, 4, os.date("%a %d %b", now()), C.dim, C.panel)

  local cx, cy, cw, ch = 2, 6, W - 2, H - 7
  if ui.tab == "tracking" then drawTracking(cx, cy, cw, ch)
  elseif ui.tab == "chat" then drawChat(cx, cy, cw, ch)
  else drawHeat(cx, cy, cw, ch) end

  -- footer
  fill(1, H, W, 1, C.panel)
  local onl = 0
  for _, p in pairs(data.players) do if p.online then onl = onl + 1 end end
  dot(2, H, onl > 0 and C.green or C.dim)
  text(4, H, onl .. " online", C.text, C.panel)
  local sv = (lastSave > 0) and ("saved " .. ago(lastSave) .. " ago") or "not saved yet"
  text(16, H, sv, C.dim, C.panel)
  if nbt then
    text(34, H, string.format("NBT %.1f/%.1f KB", lastSaveBytes / 1024, CONFIG.NBT_BUDGET / 1024), nbtOK and C.green or C.red, C.panel)
  end
  local lk = "auto-lock in " .. lockRemaining()
  text(W - #lk - 1, H, lk, C.dim, C.panel)
end

local function render()
  hits = {}
  win.setVisible(false)
  win.setCursorBlink(false)
  if ui.locked then drawLock() else drawApp() end
  if ui.modal and not ui.locked then
    local saved = hits
    hits = {}
    local m = ui.modal
    if m.type == "confirm" then drawConfirm(m)
    elseif m.type == "kbd" then drawKbd(m)
    elseif m.type == "users" then drawUsers(m) end
  end
  win.setVisible(true)
end

--------------------------------------------------------------------
-- INPUT HANDLING
--------------------------------------------------------------------
local function lock()
  ui.locked = true; ui.pin = ""; ui.msg = ""; ui.modal = nil
  hm.playing = false
end

local function cycle(v, n) return (v % n) + 1 end

local function handleHit(h, tx, ty)
  local id, d = h.id, h.data

  -- modals first
  if id == "mcancel" then ui.modal = nil; return end
  if id == "mconfirm" then
    local f = ui.modal and ui.modal.yes
    ui.modal = nil
    if f then f() end
    return
  end
  if id == "key" then
    if #ui.modal.buf < 40 then ui.modal.buf = ui.modal.buf .. d end return
  elseif id == "kbs" then ui.modal.buf = ui.modal.buf:sub(1, -2) return
  elseif id == "kclr" then ui.modal.buf = "" return
  elseif id == "kok" then
    cs.q = ui.modal.buf; ui.modal = nil; bumpFilter(); return
  elseif id == "upick" then
    cs.users[d] = (not cs.users[d]) or nil; bumpFilter(); return
  elseif id == "uclear" then cs.users = {}; bumpFilter(); return
  elseif id == "udone" then ui.modal = nil; return
  elseif id == "upg-" then ui.modal.page = ui.modal.page - 1; return
  elseif id == "upg+" then ui.modal.page = ui.modal.page + 1; return
  end

  -- lock screen
  if id == "pin" then
    if now() < ui.lockUntil then return end
    ui.msg = ""
    if d == "C" then ui.pin = ""
    elseif d == "<" then ui.pin = ui.pin:sub(1, -2)
    elseif #ui.pin < 4 then
      ui.pin = ui.pin .. d
      if #ui.pin == 4 then
        if ui.pin == CONFIG.PIN then
          ui.locked = false; ui.pin = ""; ui.wrong = 0; ui.lastAct = now()
        else
          ui.pin = ""; ui.wrong = ui.wrong + 1; ui.msg = "Incorrect PIN"
          if ui.wrong >= 5 then ui.lockUntil = now() + 30; ui.wrong = 0; ui.msg = "" end
        end
      end
    end
    return
  end

  -- header
  if id == "tab" then ui.tab = d
  elseif id == "lock" then lock()

  -- tracking
  elseif id == "trkrow" then trk.sel = d
  elseif id == "trkup" then trk.scroll = math.max(0, trk.scroll - 6)
  elseif id == "trkdn" then trk.scroll = trk.scroll + 6
  elseif id == "trkheat" then
    if trk.sel and data.heat[trk.sel] and #data.heat[trk.sel] > 0 then
      hm.player = trk.sel; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
    end
    ui.tab = "heat"
  elseif id == "trkdel" then
    local name = trk.sel
    if name then
      confirm("Delete ALL tracking data, last-seen location and heatmap history for " .. name .. "?",
        function() deletePlayer(name) end)
    end

  -- chat
  elseif id == "fuser" then ui.modal = { type = "users", page = 1 }
  elseif id == "fday" then cs.day = cycle(cs.day, #DAYS); bumpFilter()
  elseif id == "ftime" then cs.time = cycle(cs.time, #TIMES); bumpFilter()
  elseif id == "flen" then cs.len = cycle(cs.len, #LENS); bumpFilter()
  elseif id == "fevents" then cs.events = not cs.events; bumpFilter()
  elseif id == "fsearch" then ui.modal = { type = "kbd", buf = cs.q, title = "SEARCH CHAT MESSAGES" }
  elseif id == "freset" then
    cs.users = {}; cs.day = 1; cs.time = 1; cs.len = 1; cs.events = true; cs.q = ""; bumpFilter()
  elseif id == "cmsg" then cs.sel[d] = (not cs.sel[d]) or nil
  elseif id == "cup" then cs.scroll = cs.scroll + 8
  elseif id == "cdn" then cs.scroll = math.max(0, cs.scroll - 8)
  elseif id == "ctop" then cs.scroll = 1e9
  elseif id == "cbot" then cs.scroll = 0
  elseif id == "cdelsel" then
    local n = 0
    local set = {}
    for e in pairs(cs.sel) do set[e] = true; n = n + 1 end
    if n > 0 then confirm("Delete the " .. n .. " selected message(s) from history?", function() deleteChat(set) end) end
  elseif id == "cdelall" then
    local set, n = {}, #cs.filtered
    for _, e in ipairs(cs.filtered) do set[e] = true end
    if n > 0 then confirm("Delete all " .. n .. " messages currently shown by the filters?", function() deleteChat(set) end) end

  -- heatmap
  elseif id == "hprev" or id == "hnext" then
    local list = heatPlayers()
    if #list > 0 then
      local i = 1
      for k, n in ipairs(list) do if n == hm.player then i = k end end
      i = i + (id == "hnext" and 1 or -1)
      if i < 1 then i = #list elseif i > #list then i = 1 end
      hm.player = list[i]; hm.tp = nil; hm.follow = true; hm.dim = nil; hm.playing = false
    end
  elseif id == "hdim" then
    local s = hm.player and data.heat[hm.player]
    if s then
      local dims = playerDims(s)
      local opts = { false }
      for _, v in ipairs(dims) do opts[#opts + 1] = v end
      local cur = 1
      for i, v in ipairs(opts) do if v == (hm.dim or false) then cur = i end end
      local nxt = opts[(cur % #opts) + 1]
      hm.dim = nxt or nil
    end
  elseif id == "hplay" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      if hm.playing then hm.playing = false
      else
        local t0, tN = s[1][1], s[#s][1]
        if hm.rate > 0 and (hm.tp or tN) >= tN then hm.tp = t0 end
        if hm.rate < 0 and (hm.tp or t0) <= t0 then hm.tp = tN end
        hm.playing = true; hm.follow = false; hm.last = os.epoch("utc") / 1000
      end
    end
  elseif id == "hff" or id == "hrew" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      local dir = (id == "hff") and 1 or -1
      if hm.playing and (hm.rate > 0) == (dir > 0) then
        local r = math.abs(hm.rate) * 2
        if r > 16 then r = 1 end
        hm.rate = r * dir
      else
        hm.rate = dir
        if dir > 0 and (hm.tp or 0) >= s[#s][1] then hm.tp = s[1][1] end
        if dir < 0 and (hm.tp or 0) <= s[1][1] then hm.tp = s[#s][1] end
        hm.playing = true
      end
      hm.follow = false; hm.last = os.epoch("utc") / 1000
    end
  elseif id == "hstart" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then hm.tp = s[1][1]; hm.follow = false; hm.playing = false end
  elseif id == "hend" then
    hm.follow = true; hm.playing = false
  elseif id == "hseek" then
    local s = hm.player and data.heat[hm.player]
    if s and #s > 0 then
      local frac = clamp((tx - h.x) / math.max(1, h.w - 1), 0, 1)
      local t0, tN = s[1][1], s[#s][1]
      hm.tp = t0 + frac * (tN - t0)
      hm.follow = false
    end
  elseif id == "hdel" then
    local name = hm.player
    if name then
      confirm("Delete the entire heatmap history for " .. name .. "?", function() deleteHeat(name) end)
    end
  end
end

local function onTouch(tx, ty)
  if not ui.locked then ui.lastAct = now() end
  for i = #hits, 1, -1 do
    local h = hits[i]
    if tx >= h.x and tx < h.x + h.w and ty >= h.y and ty < h.y + h.h then
      handleHit(h, tx, ty)
      return
    end
  end
end

local function frame()
  local t = os.epoch("utc") / 1000
  local dt = t - (hm.last or t)
  hm.last = t
  if not hm.playing then return end
  local s = hm.player and data.heat[hm.player]
  if not s or #s == 0 then hm.playing = false; return end
  local t0, tN = s[1][1], s[#s][1]
  local span = math.max(tN - t0, 60)
  hm.tp = (hm.tp or tN) + hm.rate * span / 30 * dt
  if hm.rate > 0 and hm.tp >= tN then hm.tp = tN; hm.playing = false; hm.follow = true
  elseif hm.rate < 0 and hm.tp <= t0 then hm.tp = t0; hm.playing = false end
end

--------------------------------------------------------------------
-- MAIN
--------------------------------------------------------------------
local function main()
  loadData()
  poll()
  startup = false
  saveNow()
  local tickT = os.startTimer(1)
  local frameT
  local tick = 0
  render()

  while true do
    local ev = { os.pullEventRaw() }
    local e = ev[1]
    local redraw = false

    if e == "terminate" then
      break

    elseif e == "monitor_touch" and ev[2] == monName then
      onTouch(ev[3], ev[4]); redraw = true

    elseif e == "chat" then
      -- chat_box event: username, message, uuid, isHidden
      if ev[2] and ev[3] then
        logEvent("c", ev[2], ev[3])
        ensurePlayer(ev[2])
        redraw = true
      end

    elseif e == "playerJoin" then
      if ev[2] then setOnline(ev[2]); redraw = true end

    elseif e == "playerLeave" then
      if ev[2] then setOffline(ev[2]); redraw = true end

    elseif e == "playerChangedDimension" then
      if ev[2] then
        local p = ensurePlayer(ev[2])
        if ev[4] then p.dim = dimId(ev[4]) end
        addSample(ev[2], p, true)
        redraw = true
      end

    elseif e == "char" then
      if ui.modal and ui.modal.type == "kbd" and #ui.modal.buf < 40 then
        ui.modal.buf = ui.modal.buf .. ev[2]; redraw = true
      end
      if not ui.locked then ui.lastAct = now() end

    elseif e == "key" then
      if ui.modal and ui.modal.type == "kbd" then
        if ev[2] == keys.backspace then ui.modal.buf = ui.modal.buf:sub(1, -2); redraw = true
        elseif ev[2] == keys.enter then cs.q = ui.modal.buf; ui.modal = nil; bumpFilter(); redraw = true end
      end

    elseif e == "timer" then
      if ev[2] == tickT then
        tickT = os.startTimer(1)
        tick = tick + 1
        if tick % CONFIG.POLL_EVERY == 0 then poll() end
        if not ui.locked and now() - ui.lastAct >= CONFIG.LOCK_AFTER then lock() end
        if dirty and now() - lastSave >= CONFIG.SAVE_EVERY then saveNow() end
        redraw = true
      elseif ev[2] == frameT then
        frameT = nil
        frame()
        redraw = true
      end
    end

    if hm.playing and not frameT and not ui.locked and ui.tab == "heat" then
      hm.last = hm.last or (os.epoch("utc") / 1000)
      frameT = os.startTimer(0.1)
    end
    if redraw then render() end
  end

  saveNow()
end

local ok, err = pcall(main)
pcall(function() mon.setBackgroundColor(colors.black); mon.clear() end)
restorePalette(mon)
if not ok then
  pcall(saveNow)
  error(err, 0)
end
print("NEXUS stopped. Data saved.")
